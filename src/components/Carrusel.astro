---
// El patrón que más se repite en la referencia: columna izquierda con título
// y descripción, y a la derecha una fila de tarjetas con fondo pastel que se
// desplaza con flechas (y con el dedo en móvil).
//
// Donde la referencia pone "Comienza desde $16.67", aquí va una muestra de
// los trabajos de la categoría: el sitio es informativo, no vende en línea.
import { CATEGORIAS, type Categoria } from '../consts';
import Foto from './Foto.astro';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Qué categorías mostrar; por defecto, todas. */
  slugs?: readonly string[];
  fondo?: 'blanco' | 'mist';
  id?: string;
}

const { titulo, descripcion, slugs, fondo = 'blanco', id } = Astro.props;

const items: Categoria[] = slugs
  ? (slugs.map((s) => CATEGORIAS.find((c) => c.slug === s)).filter(Boolean) as Categoria[])
  : CATEGORIAS;

const tonos: Record<string, string> = {
  card1: 'bg-card1',
  card2: 'bg-card2',
  card3: 'bg-card3',
  card4: 'bg-card4',
};
---

<section id={id} class={fondo === 'mist' ? 'bg-paper py-12 md:py-16' : 'bg-white py-12 md:py-16'}>
  <div class="shell" data-carrusel>
    <div class="grid gap-6 lg:grid-cols-[260px_1fr] lg:gap-10">
      <div class="reveal lg:pt-4">
        <h2 class="h-sec">{titulo}</h2>
        {descripcion && <p class="mt-4 max-w-md text-[15px] leading-relaxed">{descripcion}</p>}

        <!-- En escritorio las flechas viven bajo el título; en móvil se
             ocultan porque el carril se arrastra con el dedo. -->
        <div class="mt-6 hidden gap-3 lg:flex">
          <button type="button" data-prev class="arrow" aria-label="Anterior">
            <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button type="button" data-next class="arrow" aria-label="Siguiente">
            <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>

      <ul class="rail reveal -mx-[15px] px-[15px] sm:mx-0 sm:px-0">
        {
          items.map((c) => (
            <li class="w-[210px] sm:w-[240px]">
              <a href={`/catalogo/${c.slug}/`} class="zoom-parent group block">
                <div class={`overflow-hidden ${tonos[c.tono] ?? 'bg-paper'}`}>
                  <Foto
                    id={c.imagen}
                    alt={c.imagenAlt}
                    ratio="1/1"
                    sizes="240px"
                    class="zoom-img"
                  />
                </div>
                <h3 class="mt-3 flex items-start gap-1.5 text-[16px] font-semibold leading-snug text-ink group-hover:text-brand">
                  {c.etiqueta}
                  <svg
                    viewBox="0 0 16 16"
                    class="mt-1 h-3.5 w-3.5 shrink-0 transition-transform duration-300 group-hover:translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </h3>
                <p class="mt-1 text-[13px] leading-relaxed text-ash">
                  {c.ejemplos.slice(0, 2).join(' · ')}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
