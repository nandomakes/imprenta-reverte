---
import { CONTACT, PHONE_DISPLAY, PHONE_TEL, SITE } from '../consts';
---

<section id="ubicacion" class="scroll-mt-32 bg-white py-12 md:py-16">
  <div class="shell grid gap-8 lg:grid-cols-2 lg:gap-12">
    <div>
      <h2 class="h-sec reveal">Pasa por el local en Zona Centro</h2>

      <address class="reveal mt-7 space-y-6 not-italic">
        <div>
          <h3 class="eyebrow text-[13px]">Dirección</h3>
          <p class="mt-1.5 text-[17px] leading-relaxed text-ink">
            {CONTACT.street}<br />
            {CONTACT.neighborhood}<br />
            {CONTACT.locality}, {CONTACT.region}
          </p>
        </div>

        <div>
          <h3 class="eyebrow text-[13px]">Teléfono</h3>
          <p class="mt-1.5">
            <a href={`tel:${PHONE_TEL}`} class="text-[26px] font-semibold text-brand hover:underline">
              {PHONE_DISPLAY}
            </a>
          </p>
        </div>

        <div>
          <h3 class="eyebrow text-[13px]">Horario</h3>
          <p class="mt-1.5 text-[16px] text-ink">{CONTACT.hoursText}</p>
        </div>
      </address>

      <a href={CONTACT.mapsUrl} target="_blank" rel="noopener" class="btn-brand reveal mt-8">
        Cómo llegar
      </a>
    </div>

    <div class="reveal min-h-[320px] border border-line">
      <iframe
        src={CONTACT.mapEmbedUrl}
        title={`Mapa de la ubicación de ${SITE.brand} en ${CONTACT.locality}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="h-full min-h-[320px] w-full border-0"></iframe>
    </div>
  </div>
</section>
