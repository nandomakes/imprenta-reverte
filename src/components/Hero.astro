---
// Hero de la referencia: fondo crema, titular manuscrito, subtítulo, botón
// magenta, imagen a la derecha, flechas a los lados y borde de papel rasgado
// abajo. Slider con dos diapositivas.
import { HERO_SLIDES } from '../consts';
import Foto from './Foto.astro';
---

<section
  data-slider
  class="torn-b relative bg-cream"
  aria-roledescription="carrusel"
  aria-label="Destacados"
>
  <div class="relative">
    {
      HERO_SLIDES.map((s, i) => (
        <div
          data-slide
          class:list={[
            'transition-opacity duration-700',
            i === 0 ? '' : 'absolute inset-0 opacity-0 pointer-events-none',
          ]}
          role="group"
          aria-label={`Diapositiva ${i + 1} de ${HERO_SLIDES.length}`}
        >
          <div class="shell grid items-center gap-6 py-10 sm:py-14 lg:grid-cols-2 lg:gap-10 lg:py-16">
            <div class="order-2 lg:order-1">
              <p class="font-script text-[34px] leading-[1.15] text-accent sm:text-[46px] lg:text-[56px]">
                {s.script}
              </p>
              <h1 class="mt-2 text-[22px] font-medium leading-snug text-ink sm:text-[26px] lg:text-[30px]">
                {s.titulo}
              </h1>
              <a href={s.href} class="btn-accent mt-6 uppercase tracking-wide">
                {s.cta}
              </a>
            </div>
            <div class="order-1 lg:order-2">
              <Foto
                id={s.imagen}
                alt={s.alt}
                prioridad={i === 0}
                ratio="16/10"
                sizes="(min-width:1024px) 620px, 100vw"
                class="shadow-xl"
              />
            </div>
          </div>
        </div>
      ))
    }

    <!-- Flechas -->
    <button
      type="button"
      data-slider-prev
      class="absolute left-2 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-brand shadow-md transition hover:bg-white sm:left-4"
      aria-label="Anterior"
    >
      <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button
      type="button"
      data-slider-next
      class="absolute right-2 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-brand shadow-md transition hover:bg-white sm:right-4"
      aria-label="Siguiente"
    >
      <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>

    <!-- Puntos -->
    {/* La barra que se ve mide 8px de alto, pero el botón lleva relleno
        vertical para dar un área táctil cómoda en móvil. */}
    <div class="absolute bottom-1 left-1/2 z-10 flex -translate-x-1/2">
      {
        HERO_SLIDES.map((_, i) => (
          <button
            type="button"
            data-punto
            aria-current={i === 0 ? 'true' : 'false'}
            class="group px-2 py-3"
            aria-label={`Ir a la diapositiva ${i + 1}`}
          >
            <span class="block h-2 w-6 bg-ink/25 transition-colors group-aria-[current=true]:bg-accent" />
          </button>
        ))
      }
    </div>
  </div>
</section>
