---
// Hero único y estático, a pantalla completa. Antes era un carrusel de dos
// diapositivas con autoavance; se quitó porque rotar el mensaje principal cada
// 6.5 s no dejaba leer ninguno de los dos.
//
// La foto ahora es el fondo de TODA la sección (antes iba en una columna
// aparte, a la derecha). Con la foto detrás, el texto pasa a blanco y lleva
// un degradado oscuro debajo para que siga siendo legible sobre cualquier
// zona de la imagen, no solo sobre las partes ya oscuras.
//
// El alto es la pantalla MENOS la cabecera, no 100svh a secas: la cabecera es
// sticky y ocupa sitio en el flujo, así que con 100svh el hero se saldría por
// abajo justo esa altura. `--alto-cabecera` la mide el script de Layout en cada
// resize; el 112px del fallback es lo que mide en escritorio si el JS no llega.
import { HERO } from '../consts';
import Foto from './Foto.astro';
---

<section class="torn-b relative flex min-h-[calc(100svh-var(--alto-cabecera,112px))] items-center overflow-hidden bg-brand">
  <div class="absolute inset-0">
    <Foto id={HERO.imagen} alt={HERO.alt} prioridad sizes="100vw" class="h-full w-full" />
    {/* Degradado de izquierda a derecha, no un velo parejo: el texto vive a
        la izquierda y ahí es donde de verdad necesita el contraste; a la
        derecha se deja ver más la foto. */}
    <div class="absolute inset-0 bg-gradient-to-r from-brand/90 via-brand/55 to-brand/10" />
  </div>

  <div class="shell relative w-full">
    <div class="max-w-xl">
      <h1 class="text-[40px] leading-[1.1] text-white sm:text-[52px] lg:text-[62px]">
        {HERO.script}
      </h1>
      <p class="mt-4 max-w-[38ch] text-[17px] leading-snug text-white/85 sm:text-[19px]">
        {HERO.titulo}
      </p>
      <a href={HERO.href} class="btn-accent mt-7">
        {HERO.cta}
      </a>
    </div>
  </div>
</section>
