---
// Banda celeste con borde rasgado arriba y dos tarjetas blancas con icono
// circular y botón azul. Es el cierre de la referencia antes del boletín.
import { CTA_DUO } from '../consts';
---

<section class="torn-t relative mt-10 bg-mist py-14 md:py-20">
  <div class="shell grid gap-6 md:grid-cols-2">
    {
      CTA_DUO.map((c) => (
        <div class="reveal flex items-center gap-5 bg-white p-6 sm:gap-7 sm:p-8">
          <span
            class="grid h-[72px] w-[72px] shrink-0 place-items-center rounded-full bg-mist text-brand"
            aria-hidden="true"
          >
            {c.icono === 'documento' ? (
              <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2v-8" />
                <path d="M14 3v6h6" />
                <path d="M12 17l5.5-5.5a1.8 1.8 0 10-2.5-2.5L9.5 14.5 9 17z" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="10" cy="8" r="4" />
                <path d="M2.5 20a7.5 7.5 0 0115 0" />
                <path d="M18 6v6M15 9h6" stroke-linecap="round" />
              </svg>
            )}
          </span>
          <div>
            <p class="text-[15px] leading-relaxed">{c.texto}</p>
            <a href={c.href} class="btn-brand mt-4">
              {c.boton}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>
