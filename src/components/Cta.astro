---
// El botón de cotización. Existe como componente para que la etiqueta
// "Cotiza ahora" salga SIEMPRE de CTA_LABEL y nadie pueda escribir una
// variante a mano en una plantilla suelta.
import { CTA_LABEL } from '../consts';

interface Props {
  href?: string;
  /** El magenta es el CTA principal de la referencia; el azul, secundario. */
  tono?: 'accent' | 'brand';
  class?: string;
}

const { href = '/cotizar/', tono = 'accent', class: clase = '' } = Astro.props;
---

<a href={href} class={`${tono === 'accent' ? 'btn-accent' : 'btn-brand'} ${clase}`}>
  {CTA_LABEL}
</a>
