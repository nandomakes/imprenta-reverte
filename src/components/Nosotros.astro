---
import { CONTACT, IMAGES } from '../consts';
import Foto from './Foto.astro';
import Cta from './Cta.astro';
---

<section id="nosotros" class="bg-white">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 md:py-20 lg:grid-cols-2">
    <div class="reveal overflow-hidden rounded-2xl border border-line">
      <Foto
        id={IMAGES.nosotros.id}
        alt={IMAGES.nosotros.alt}
        ratio="4/3"
        sizes="(min-width:1024px) 560px, 100vw"
      />
    </div>

    <div>
      <p class="kicker reveal">Quiénes somos</p>
      <h2 class="headline reveal mt-3 text-3xl text-ink sm:text-4xl">
        Una imprenta de {CONTACT.locality}, para los negocios de {CONTACT.locality}
      </h2>
      <div class="reveal mt-5 space-y-4 text-lg leading-relaxed text-char">
        <p>
          Imprenta Reverte está sobre el Blvd. México - Laredo, en plena Zona Centro. Atendemos a
          consultorios, restaurantes, escuelas, ferreterías, constructoras y a cualquiera que
          necesite algo impreso, desde una taza hasta el uniforme de toda la plantilla.
        </p>
        <p>
          Trabajamos con lo que el catálogo 2026 cubre: papelería comercial y médica, publicidad,
          gran formato, textil, grabado láser, sellos y eventos. Si tu trabajo no encaja en ninguna
          de esas, pregúntanos igual — casi siempre hay una forma de resolverlo.
        </p>
      </div>

      <dl class="reveal mt-8 grid grid-cols-2 gap-6 border-t border-line pt-6">
        <div>
          <dt class="text-sm text-ash">Categorías en catálogo</dt>
          <dd class="font-display text-3xl font-bold text-brand">9</dd>
        </div>
        <div>
          <dt class="text-sm text-ash">Tiraje mínimo</dt>
          <dd class="font-display text-3xl font-bold text-brand">1 pieza</dd>
        </div>
      </dl>

      <div class="reveal mt-8">
        <Cta href="/contacto/#cotizar" tamano="lg" />
      </div>
    </div>
  </div>
</section>
