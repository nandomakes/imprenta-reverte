---
// Footer navy a cuatro columnas, igual que la referencia: marca +
// eslogan, Productos (a dos columnas), Enlaces rápidos, Contacto con redes
// en círculos, y barra inferior de copyright.
import { Image } from 'astro:assets';
import clicksrunLogo from '../assets/images/logo-clicksrun.webp';
import {
  CATEGORIAS,
  CONTACT,
  EMAIL,
  ENLACES_RAPIDOS,
  PHONE_DISPLAY,
  PHONE_TEL,
  SITE,
  SOCIALS,
} from '../consts';
import Logo from './Logo.astro';

interface Props {
  /**
   * Quita WhatsApp de la fila de redes. Lo usa /gracias: ahí el prospecto ya
   * dejó sus datos y el siguiente paso lo da la imprenta — un ícono de
   * WhatsApp en ese momento solo se lleva la conversación a un chat que
   * nadie registró. Facebook e Instagram se quedan: esos no abren una
   * conversación de venta, solo muestran el negocio.
   */
  sinWhatsApp?: boolean;
}

const { sinWhatsApp = false } = Astro.props;

const anio = new Date().getFullYear();
const mitad = Math.ceil(CATEGORIAS.length / 2);
const redes = sinWhatsApp ? SOCIALS.filter((s) => s.icon !== 'whatsapp') : SOCIALS;
const col1 = CATEGORIAS.slice(0, mitad);
const col2 = CATEGORIAS.slice(mitad);
---

<footer class="bg-brand text-white">
  <div class="shell py-12 md:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.1fr_1.6fr_1fr_1fr]">
      <div>
        <Logo tono="blanco" />
        <p class="mt-5 max-w-[280px] text-[17px] font-semibold leading-snug">
          {SITE.tagline}
        </p>
      </div>

      <div>
        <h2 class="text-[19px] font-semibold">Catálogo</h2>
        <div class="mt-5 grid gap-x-6 gap-y-3 sm:grid-cols-2">
          <ul class="space-y-3 text-[15px]">
            {
              col1.map((c) => (
                <li>
                  <a href={`/catalogo/${c.slug}/`} class="text-white/85 hover:text-white">
                    {c.etiqueta}
                  </a>
                </li>
              ))
            }
          </ul>
          <ul class="space-y-3 text-[15px]">
            {
              col2.map((c) => (
                <li>
                  <a href={`/catalogo/${c.slug}/`} class="text-white/85 hover:text-white">
                    {c.etiqueta}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div>
        <h2 class="text-[19px] font-semibold">Enlaces rápidos</h2>
        <ul class="mt-5 space-y-3 text-[15px]">
          {
            ENLACES_RAPIDOS.map((e) => (
              <li>
                <a href={e.href} class="text-white/85 hover:text-white">
                  {e.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-[19px] font-semibold">Contacto</h2>
        <ul class="mt-5 space-y-3.5 text-[15px]">
          <li class="flex items-start gap-3">
            <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M12 21s-7-4.5-7-10a7 7 0 1114 0c0 5.5-7 10-7 10z"></path>
              <circle cx="12" cy="11" r="2.5"></circle>
            </svg>
            <address class="not-italic leading-relaxed text-white/85">
              {CONTACT.street}<br />{CONTACT.neighborhood}<br />
              {CONTACT.locality}, {CONTACT.region}
            </address>
          </li>
          <li class="flex items-center gap-3">
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="currentColor">
              <path
                d="M2.5 4.5A2 2 0 014.5 2.5h2a2 2 0 011.94 1.5l.7 2.7a2 2 0 01-.53 1.94l-1.2 1.2a14.5 14.5 0 006.75 6.75l1.2-1.2a2 2 0 011.94-.53l2.7.7a2 2 0 011.5 1.94v2a2 2 0 01-2 2C10.6 21.5 2.5 13.4 2.5 4.5z"
              ></path>
            </svg>
            <a href={`tel:${PHONE_TEL}`} class="font-semibold hover:underline">{PHONE_DISPLAY}</a>
          </li>
          <li class="flex items-center gap-3">
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="2.5" y="5" width="19" height="14" rx="2"></rect>
              <path d="M3 6.5l9 6 9-6"></path>
            </svg>
            <a href={`mailto:${EMAIL}`} class="text-white/85 hover:text-white">{EMAIL}</a>
          </li>
          <li class="pt-1 text-white/85">{CONTACT.hoursText}</li>
        </ul>

        <ul class="mt-6 flex gap-3">
          {
            redes.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="grid h-11 w-11 place-items-center rounded-full bg-white text-brand transition hover:bg-white/85"
                  aria-label={s.label}
                >
                  {s.icon === 'facebook' && (
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
                      <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.29-.04-1.27-.12-2.41-.12-2.38 0-4.01 1.45-4.01 4.13v2.29H7.6V13h2.68v8z" />
                    </svg>
                  )}
                  {s.icon === 'instagram' && (
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9">
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                  {/* Glifo oficial de WhatsApp (el mismo path que en el FAB
                      flotante): antes iba una aproximación dibujada a mano
                      que no correspondía al logo real. */}
                  {s.icon === 'whatsapp' && (
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M20.463 3.488A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/20">
    <div class="shell flex flex-col items-center gap-4 py-5 text-[13px] text-white/80 sm:flex-row sm:justify-between">
      <div class="flex flex-col items-center gap-2 text-center sm:items-start sm:text-left">
        <p>© {anio} Imprenta Reverte. Todos los derechos reservados.</p>
        <p>
          Sitio informativo · Fotografías de{' '}
          <a href="https://unsplash.com" target="_blank" rel="noopener" class="underline hover:text-white">
            Unsplash
          </a>
        </p>
      </div>
      <a
        href="https://clicksrun.com"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3 opacity-70 transition-opacity duration-200 hover:opacity-100"
        aria-label="Sitio creado por ClicksRun"
      >
        <span class="text-[10px] uppercase tracking-[0.25em] text-white/60">Sitio creado por</span>
        <Image src={clicksrunLogo} alt="ClicksRun" class="h-10 w-auto" loading="lazy" />
      </a>
    </div>
  </div>
</footer>
