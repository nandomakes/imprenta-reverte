---
// Cabecera calcada de printshopsolution.com: barra promo con degradado,
// fila de marca (logo · buscador píldora · acciones) y fila de navegación.
// En móvil colapsa a hamburguesa + logo + iconos, con panel deslizante.
import { NAV, PROMO_BAR, PHONE_DISPLAY, PHONE_TEL, CTA_LABEL, CATEGORIAS } from '../consts';
import Logo from './Logo.astro';

const ruta = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
const etiquetaDe = (slug: string) => CATEGORIAS.find((c) => c.slug === slug);
---

<!-- Barra promocional con degradado, cerrable -->
<div data-promo class="relative overflow-hidden text-white">
  <div
    class="absolute inset-0"
    style="background:linear-gradient(90deg,#C2622A 0%,#0E7490 28%,#0221C4 58%,#7B2FA8 82%,#E00087 100%)"
    aria-hidden="true"
  >
  </div>
  {/* pr-9 reserva el hueco de la × para que nunca se monte sobre el texto
      cuando este envuelve a dos líneas en pantallas estrechas. */}
  <div class="shell relative flex items-center justify-center py-2 pr-9 text-center text-[12.5px] leading-snug sm:text-[14px]">
    <p>
      {PROMO_BAR.texto}{' '}
      <a href={PROMO_BAR.href} class="whitespace-nowrap font-semibold underline underline-offset-2">
        {PROMO_BAR.enlaceTexto}
      </a>
    </p>
    <button
      type="button"
      data-promo-cerrar
      class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-white/80 hover:text-white"
      aria-label="Cerrar aviso"
    >
      <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 3l10 10M13 3L3 13" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</div>

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <!-- Fila de marca -->
  <div class="shell flex items-center justify-between gap-4 py-3 lg:py-4">
    <!-- Hamburguesa (solo móvil) -->
    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="menu-movil"
      class="-ml-1 p-2 text-brand lg:hidden"
    >
      <span class="sr-only">Abrir menú</span>
      <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"></path>
      </svg>
    </button>

    <a href="/" class="shrink-0" aria-label="Imprenta Reverte — inicio">
      <Logo />
    </a>

    <!-- Buscador píldora (solo escritorio). Filtra el catálogo, no una tienda. -->
    <form action="/catalogo/" method="get" role="search" class="hidden max-w-[520px] flex-1 lg:block">
      <label for="q" class="sr-only">Buscar en el catálogo</label>
      <div class="relative">
        <input
          id="q"
          name="q"
          type="search"
          placeholder="¿Qué necesitas imprimir?"
          class="w-full rounded-full border border-line bg-white py-3 pl-6 pr-14 text-[15px] text-ink placeholder:text-ash focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
        />
        <button
          type="submit"
          class="absolute right-1.5 top-1/2 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-full text-brand hover:bg-brand/10"
          aria-label="Buscar"
        >
          <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="9" r="6"></circle>
            <path d="M13.5 13.5L18 18" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </form>

    <!-- Acciones escritorio -->
    <div class="hidden shrink-0 items-center gap-5 lg:flex">
      <a href="/cotizar/" class="btn-brand rounded-none px-5 py-2.5 text-[14px]">
        {CTA_LABEL}
      </a>
      <a
        href="/contacto/"
        class="flex items-center gap-2 text-[15px] text-ink hover:text-brand"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M12 21s-7-4.5-7-10a7 7 0 1114 0c0 5.5-7 10-7 10z"></path>
          <circle cx="12" cy="11" r="2.5"></circle>
        </svg>
        Ubicación
      </a>
      <a
        href={`tel:${PHONE_TEL}`}
        class="flex items-center gap-2 text-[15px] font-semibold text-ink hover:text-brand"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
          <path
            d="M2.5 4.5A2 2 0 014.5 2.5h2a2 2 0 011.94 1.5l.7 2.7a2 2 0 01-.53 1.94l-1.2 1.2a14.5 14.5 0 006.75 6.75l1.2-1.2a2 2 0 011.94-.53l2.7.7a2 2 0 011.5 1.94v2a2 2 0 01-2 2C10.6 21.5 2.5 13.4 2.5 4.5z"
          ></path>
        </svg>
        {PHONE_DISPLAY}
      </a>
    </div>

    <!-- Acciones móvil -->
    <div class="flex shrink-0 items-center gap-1 lg:hidden">
      <a href={`tel:${PHONE_TEL}`} class="p-2 text-brand" aria-label={`Llamar al ${PHONE_DISPLAY}`}>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
          <path
            d="M2.5 4.5A2 2 0 014.5 2.5h2a2 2 0 011.94 1.5l.7 2.7a2 2 0 01-.53 1.94l-1.2 1.2a14.5 14.5 0 006.75 6.75l1.2-1.2a2 2 0 011.94-.53l2.7.7a2 2 0 011.5 1.94v2a2 2 0 01-2 2C10.6 21.5 2.5 13.4 2.5 4.5z"
          ></path>
        </svg>
      </a>
      <a href="/catalogo/" class="p-2 text-brand" aria-label="Buscar en el catálogo">
        <svg viewBox="0 0 20 20" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="9" r="6"></circle>
          <path d="M13.5 13.5L18 18" stroke-linecap="round"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Fila de navegación (escritorio) -->
  <nav aria-label="Categorías" class="hidden border-t border-line lg:block">
    <ul class="shell flex items-center justify-between gap-1">
      {
        NAV.map((item, i) => (
          <li class="group relative">
            <a
              href={item.href}
              class:list={[
                'block whitespace-nowrap px-3 py-3.5 text-[15px] transition-colors',
                activo(item.href) ? 'text-brand' : 'text-ink hover:text-brand',
              ]}
              aria-current={activo(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
            {/* Los últimos ítems anclan el panel a la derecha: si no, se sale
                del viewport y crea scroll horizontal en toda la página. */}
            {item.hijos && item.hijos.length > 1 && (
              <div
                class:list={[
                  'pointer-events-none absolute top-full z-50 w-[320px] border border-line bg-white opacity-0 shadow-xl transition-opacity duration-150 group-focus-within:pointer-events-auto group-focus-within:opacity-100 group-hover:pointer-events-auto group-hover:opacity-100',
                  i >= NAV.length - 2 ? 'right-0' : 'left-0',
                ]}
              >
                <ul class="py-2">
                  {item.hijos.map((slug) => {
                    const c = etiquetaDe(slug);
                    return c ? (
                      <li>
                        <a
                          href={`/catalogo/${c.slug}/`}
                          class="block px-5 py-2.5 text-[14px] text-ink hover:bg-mist hover:text-brand"
                        >
                          {c.etiqueta}
                        </a>
                      </li>
                    ) : null;
                  })}
                </ul>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<!-- Panel móvil -->
<div id="menu-movil" data-menu hidden class="fixed inset-0 z-[60] lg:hidden">
  <div class="absolute inset-0 bg-black/50" data-menu-cerrar aria-hidden="true"></div>
  <div class="absolute inset-y-0 left-0 flex w-[86%] max-w-[360px] flex-col bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-line px-5 py-4">
      <Logo />
      <button type="button" data-menu-cerrar class="p-2 text-ink" aria-label="Cerrar menú">
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 5l14 14M19 5L5 19" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Menú móvil" class="flex-1 overflow-y-auto px-5 py-4">
      <form action="/catalogo/" method="get" role="search" class="mb-5">
        <label for="q-movil" class="sr-only">Buscar en el catálogo</label>
        <div class="relative">
          <input
            id="q-movil"
            name="q"
            type="search"
            placeholder="¿Qué necesitas imprimir?"
            class="w-full rounded-full border border-line py-3 pl-5 pr-12 text-[15px] focus:border-brand focus:outline-none"
          />
          <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-brand" aria-label="Buscar">
            <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="9" cy="9" r="6"></circle>
              <path d="M13.5 13.5L18 18" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </form>

      <ul class="divide-y divide-line">
        <li>
          <a href="/catalogo/" class="block py-3.5 text-[17px] font-semibold text-ink">
            Todo el catálogo
          </a>
        </li>
        {
          CATEGORIAS.map((c) => (
            <li>
              <a href={`/catalogo/${c.slug}/`} class="block py-3.5 text-[16px] text-ink">
                {c.etiqueta}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/contacto/" class="block py-3.5 text-[16px] text-ink">Contacto y ubicación</a>
        </li>
        <li>
          <a href="/preguntas-frecuentes/" class="block py-3.5 text-[16px] text-ink">
            Preguntas frecuentes
          </a>
        </li>
      </ul>
    </nav>

    <div class="border-t border-line p-5">
      <a href="/cotizar/" class="btn-accent w-full">{CTA_LABEL}</a>
      <a
        href={`tel:${PHONE_TEL}`}
        class="mt-3 block text-center text-[15px] font-semibold text-brand"
      >
        {PHONE_DISPLAY}
      </a>
    </div>
  </div>
</div>
