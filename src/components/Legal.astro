---
// Cuerpo de texto para las páginas legales (privacidad, términos,
// accesibilidad). La referencia usa una columna estrecha de texto corrido.
---

<div class="shell max-w-3xl py-12 md:py-16">
  <div class="prose-legal">
    <slot />
  </div>
</div>

<style is:global>
  /* Encabezados legales: funcionales, DM Sans 600. Nunca editoriales. */
  .prose-legal h2 {
    margin-top: 2.25rem;
    font-size: 21px;
    font-weight: 600;
    font-family: theme('fontFamily.sans');
    color: theme('colors.ink');
  }
  .prose-legal h2:first-child {
    margin-top: 0;
  }
  .prose-legal p,
  .prose-legal li {
    margin-top: 0.85rem;
    font-size: 15px;
    line-height: 1.75;
  }
  .prose-legal ul {
    list-style: disc;
    padding-left: 1.35rem;
  }
  .prose-legal a {
    color: theme('colors.brand');
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-legal strong {
    font-weight: 600;
    color: theme('colors.ink');
  }
</style>
