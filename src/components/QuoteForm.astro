---
// Formulario de cotización.
//
// HTML nativo con POST a /api/cotizar: funciona aunque el JS falle o tarde,
// que en una conexión móvil de Ciudad Valles no es un caso hipotético.
// El `<select>` de categoría se genera desde el catálogo, así que añadir una
// categoría en `data/catalogo.ts` la hace aparecer aquí sin tocar nada.
import { CATALOGO } from '../data/catalogo';
import { CIUDADES_SUGERIDAS, CTA_LABEL, PHONE_DISPLAY, PHONE_TEL } from '../consts';

interface Props {
  /** Preselecciona una categoría (lo usan las fichas de catálogo). */
  categoria?: string;
  compacto?: boolean;
  /**
   * De dónde sale este lead: `sitio`, `promo_meta_ads`, `bio_instagram`…
   * Viaja al correo y a Telegram para poder comparar canales.
   */
  origen?: string;
  /** A qué ruta vuelve el visitante si el envío falla la validación. */
  retorno?: string;
}

const { categoria, compacto = false, origen = 'sitio', retorno = '/cotizar/' } = Astro.props;
---

<form
  method="POST"
  action="/api/cotizar"
  class="grid gap-4 sm:grid-cols-2"
  aria-labelledby="titulo-cotizar"
  data-form-cotizar
>
  {/* Atribución. `origen` lo fija la página; los utm_* los rellena el script
      de abajo leyendo la URL, porque en un HTML estático no se conocen en el
      servidor. Si el JS no llega, el lead entra igual: solo sin campaña. */}
  <input type="hidden" name="origen" value={origen} />
  <input type="hidden" name="retorno" value={retorno} />
  <input type="hidden" name="utm_source" data-utm="utm_source" />
  <input type="hidden" name="utm_medium" data-utm="utm_medium" />
  <input type="hidden" name="utm_campaign" data-utm="utm_campaign" />
  <input type="hidden" name="utm_content" data-utm="utm_content" />

  {/* Trampa antispam: invisible y fuera del orden de tabulación. Un humano
      nunca lo llena; los bots que rellenan todo, sí. */}
  <p class="hidden" aria-hidden="true">
    <label>
      No llenar este campo
      <input type="text" name="empresa_web" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div>
    <label class="field-label" for="nombre">Nombre <span class="text-cmykM">*</span></label>
    <input
      class="field"
      id="nombre"
      name="nombre"
      type="text"
      required
      autocomplete="name"
      placeholder="Tu nombre o el de tu negocio"
    />
  </div>

  <div>
    <label class="field-label" for="telefono">
      Teléfono o WhatsApp <span class="text-cmykM">*</span>
    </label>
    {/* `pattern` admite espacios, guiones y paréntesis porque mucha gente
        escribe "481 381 6663" o "(481) 381-6663"; el script de abajo cuenta
        solo los dígitos y exige 10. `maxlength` 16 deja margen para esos
        separadores sin permitir un número de otro país por error.
        `inputmode="numeric"` saca el teclado de números en el celular.

        El patrón va SIN barras invertidas a propósito: dentro del atributo se
        procesan como escapes de cadena, y `\-` `\s` llegaban al HTML como `-`
        y `s`, dejando la clase rota (`[0-9()-s]`, con un rango `)-s`). Por eso
        el espacio va literal y el guion al final, donde no forma rango. */}
    <input
      class="field"
      id="telefono"
      name="telefono"
      type="tel"
      required
      inputmode="numeric"
      autocomplete="tel-national"
      maxlength="16"
      pattern="[0-9 ()-]{10,16}"
      aria-describedby="ayuda-telefono"
      data-telefono
      placeholder="481 000 0000"
    />
    <p id="ayuda-telefono" class="mt-1.5 text-[13px] text-ash">
      10 dígitos, con lada. Ejemplo: 481 381 6663
    </p>
  </div>

  <div>
    <label class="field-label" for="ciudad">Ciudad <span class="text-cmykM">*</span></label>
    <input
      class="field"
      id="ciudad"
      name="ciudad"
      type="text"
      required
      list="ciudades"
      autocomplete="address-level2"
      placeholder="¿Desde dónde nos contactas?"
    />
    {/* `datalist` sugiere sin restringir: si escriben una ciudad que no está
        en la lista, se envía igual. */}
    <datalist id="ciudades">
      {CIUDADES_SUGERIDAS.map((c) => <option value={c} />)}
    </datalist>
  </div>

  <div>
    <label class="field-label" for="email">Correo <span class="text-ash">(opcional)</span></label>
    <input
      class="field"
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      placeholder="tucorreo@ejemplo.com"
    />
  </div>

  <div class="sm:col-span-2">
    <label class="field-label" for="categoria">
      ¿Qué necesitas imprimir? <span class="text-cmykM">*</span>
    </label>
    <select class="field" id="categoria" name="categoria" required>
      <option value="" disabled selected={!categoria}>Elige una categoría del catálogo</option>
      {
        CATALOGO.map((c) => (
          <option value={c.slug} selected={c.slug === categoria}>
            {c.etiqueta}
          </option>
        ))
      }
    </select>
  </div>

  <div>
    <label class="field-label" for="cantidad">
      Cantidad aproximada <span class="text-ash">(opcional)</span>
    </label>
    <input
      class="field"
      id="cantidad"
      name="cantidad"
      type="text"
      placeholder="Ej. 100 piezas, 1 block, 3×2 m"
    />
  </div>

  <div>
    <label class="field-label" for="fecha">
      ¿Para cuándo lo necesitas? <span class="text-ash">(opcional)</span>
    </label>
    <input class="field" id="fecha" name="fecha" type="text" placeholder="Ej. la próxima semana" />
  </div>

  <div class="sm:col-span-2">
    <label class="field-label" for="detalles">
      Detalles del trabajo <span class="text-ash">(opcional)</span>
    </label>
    <textarea
      class="field"
      id="detalles"
      name="detalles"
      rows={compacto ? 3 : 4}
      placeholder="Medidas, colores, si ya tienes diseño, cualquier cosa que nos ayude a cotizarte mejor."></textarea>
  </div>

  <div class="sm:col-span-2">
    <button type="submit" data-boton-enviar class="btn-brand w-full sm:w-auto">
      {CTA_LABEL}
    </button>
    <p class="mt-3 text-[14px] text-ash">
      Te respondemos en horario de tienda. ¿Es urgente? Llámanos al{' '}
      <a href={`tel:${PHONE_TEL}`} class="font-semibold text-brand underline underline-offset-2">
        {PHONE_DISPLAY}
      </a>
    </p>
  </div>
</form>

<script>
  // Copia los utm_* de la URL a los campos ocultos del formulario.
  //
  // Se guardan en sessionStorage porque el visitante de un anuncio puede
  // navegar dentro de la página antes de abrir el formulario, y en cuanto pasa
  // por un enlace interno los parámetros desaparecen de la barra. Sin esto se
  // pierde la atribución justo de los leads que más tardaron en decidirse.
  (() => {
    const CLAVE = 'reverte-utm';
    const CAMPOS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];

    let guardados: Record<string, string> = {};
    try {
      guardados = JSON.parse(sessionStorage.getItem(CLAVE) || '{}');
    } catch {
      /* modo privado o storage bloqueado: seguimos solo con la URL */
    }

    const params = new URLSearchParams(location.search);
    let hayNuevos = false;
    for (const campo of CAMPOS) {
      const v = params.get(campo);
      if (v) {
        guardados[campo] = v.slice(0, 160);
        hayNuevos = true;
      }
    }
    if (hayNuevos) {
      try {
        sessionStorage.setItem(CLAVE, JSON.stringify(guardados));
      } catch {
        /* da igual: los campos de esta página ya quedan rellenos */
      }
    }

    for (const input of document.querySelectorAll<HTMLInputElement>('[data-utm]')) {
      const campo = input.dataset.utm;
      if (campo && guardados[campo]) input.value = guardados[campo];
    }
  })();

  // Bloquea el botón en cuanto se manda el formulario: sin esto, un clic
  // doble (o alguien probando "a ver qué pasa si le doy varias veces")
  // dispara varios POST antes de que el servidor alcance a redirigir. Esto
  // es la mitad "de un clic" de la protección; la otra mitad, contra reenvíos
  // ya en otra carga de página, es la cookie de cooldown en /api/cotizar.
  document.querySelectorAll<HTMLFormElement>('[data-form-cotizar]').forEach((form) => {
    form.addEventListener('submit', () => {
      const boton = form.querySelector<HTMLButtonElement>('[data-boton-enviar]');
      if (!boton || boton.disabled) return;
      boton.disabled = true;
      boton.textContent = 'Enviando…';
    });
  });

  // Teléfono: exactamente 10 dígitos.
  //
  // `pattern` por sí solo no sirve aquí, porque cuenta caracteres y no
  // dígitos: "481 381 66" pasa el patrón (10 caracteres) con solo 8 dígitos.
  // Así que se cuentan los dígitos a mano y se usa setCustomValidity, que
  // hace que el navegador muestre el mensaje en su propio globo y bloquee el
  // envío — el mismo camino que ya usa para los campos requeridos, sin
  // inventar una UI de errores aparte.
  document.querySelectorAll<HTMLInputElement>('[data-telefono]').forEach((campo) => {
    const revisar = () => {
      const digitos = campo.value.replace(/\D/g, '');

      if (campo.value.trim() === '') {
        // Vacío no es "faltan dígitos": de eso ya se queja `required` con su
        // propio mensaje, y pisarlo aquí sería contradecirlo.
        campo.setCustomValidity('');
      } else if (digitos.length < 10) {
        const faltan = 10 - digitos.length;
        campo.setCustomValidity(
          `Faltan ${faltan} ${faltan === 1 ? 'dígito' : 'dígitos'}: el teléfono debe tener 10.`
        );
      } else if (digitos.length > 10) {
        campo.setCustomValidity('El teléfono debe tener 10 dígitos, con lada.');
      } else {
        campo.setCustomValidity('');
      }
    };

    // `input` limpia el aviso en cuanto se corrige, sin esperar a reenviar.
    // `change` cubre el autocompletado del navegador, que rellena el campo
    // sin que nadie escriba. NO se revalida en el `submit` del formulario:
    // la validación nativa corre ANTES de ese evento, así que para entonces
    // el navegador ya decidió si dejaba pasar el envío.
    campo.addEventListener('input', revisar);
    campo.addEventListener('change', revisar);
    campo.addEventListener('blur', revisar);
    revisar();
  });
</script>
