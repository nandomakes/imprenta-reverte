---
// Formulario de captura de datos. Es el MISMO en todo el sitio: /cotizar/,
// las fichas de categoría y el modal de la bio.
//
// SOLO CUATRO CAMPOS, todos obligatorios: nombre, teléfono, ciudad y código
// postal. Lo demás (correo, categoría, cantidad, fecha, detalles) se quitó a
// pedido del cliente. La razón de fondo: este formulario no cotiza, capta.
// Lo que sigue es una llamada de un asesor, y todo lo que hace falta para
// cotizar se pregunta en esa llamada. Cada campo extra aquí es un lead menos,
// sobre todo con el público de la bio, que en buena parte pasa de los 50.
//
// HTML nativo con POST a /api/cotizar: funciona aunque el JS falle o tarde,
// que en una conexión móvil de Ciudad Valles no es un caso hipotético.
import { CIUDADES_SUGERIDAS, PHONE_DISPLAY, PHONE_TEL } from '../consts';

interface Props {
  /**
   * Categoría desde la que se abrió el formulario (lo pasan las fichas de
   * catálogo). Ya NO es un campo visible: viaja oculto, como `origen`, para
   * que el asesor sepa qué estaba viendo la persona cuando dejó sus datos.
   */
  categoria?: string;
  /**
   * De dónde sale este lead: `sitio`, `bio_instagram`, `bio_facebook`…
   * Viaja al correo y a Telegram para poder comparar canales.
   */
  origen?: string;
  /** A qué ruta vuelve el visitante si el envío falla la validación. */
  retorno?: string;
}

const { categoria, origen = 'sitio', retorno = '/cotizar/' } = Astro.props;
---

<form
  method="POST"
  action="/api/cotizar"
  class="grid gap-4 sm:grid-cols-2"
  aria-labelledby="titulo-cotizar"
  data-form-cotizar
>
  {/* Atribución. `origen` y `categoria` los fija la página; los utm_* los
      rellena el script de abajo leyendo la URL, porque en un HTML estático no
      se conocen en el servidor. Si el JS no llega, el lead entra igual: solo
      sin campaña. */}
  <input type="hidden" name="origen" value={origen} />
  <input type="hidden" name="retorno" value={retorno} />
  {categoria && <input type="hidden" name="categoria" value={categoria} />}
  <input type="hidden" name="utm_source" data-utm="utm_source" />
  <input type="hidden" name="utm_medium" data-utm="utm_medium" />
  <input type="hidden" name="utm_campaign" data-utm="utm_campaign" />
  <input type="hidden" name="utm_content" data-utm="utm_content" />

  {/* Trampa antispam: invisible y fuera del orden de tabulación. Un humano
      nunca lo llena; los bots que rellenan todo, sí. */}
  <p class="hidden" aria-hidden="true">
    <label>
      No llenar este campo
      <input type="text" name="empresa_web" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div>
    <label class="field-label" for="nombre">Nombre <span class="text-cmykM">*</span></label>
    <input
      class="field"
      id="nombre"
      name="nombre"
      type="text"
      required
      autocomplete="name"
      placeholder="Tu nombre o el de tu negocio"
    />
  </div>

  <div>
    <label class="field-label" for="telefono">
      Teléfono o WhatsApp <span class="text-cmykM">*</span>
    </label>
    {/* Solo dígitos y exactamente diez: `maxlength` corta en el décimo, y el
        script de abajo (`data-solo-digitos`) descarta al vuelo cualquier cosa
        que no sea número, de modo que ni un espacio ni un guion entran. Se
        pidió así a propósito: que el campo no DEJE escribir más, en vez de
        avisar después. `inputmode="numeric"` saca el teclado de números en
        el celular. `pattern` es la red por si el script no llega. */}
    <input
      class="field"
      id="telefono"
      name="telefono"
      type="tel"
      required
      inputmode="numeric"
      autocomplete="tel-national"
      maxlength="10"
      pattern="[0-9]{10}"
      aria-describedby="ayuda-telefono"
      data-solo-digitos="10"
      data-nombre-campo="El teléfono"
      placeholder="4813816663"
    />
    <p id="ayuda-telefono" class="mt-1.5 text-[13px] text-ash">
      10 dígitos, con lada, sin espacios. Ejemplo: 4813816663
    </p>
  </div>

  <div>
    <label class="field-label" for="ciudad">Ciudad <span class="text-cmykM">*</span></label>
    <input
      class="field"
      id="ciudad"
      name="ciudad"
      type="text"
      required
      list="ciudades"
      autocomplete="address-level2"
      placeholder="¿Desde dónde nos contactas?"
    />
    {/* `datalist` sugiere sin restringir: si escriben una ciudad que no está
        en la lista, se envía igual. */}
    <datalist id="ciudades">
      {CIUDADES_SUGERIDAS.map((c) => <option value={c} />)}
    </datalist>
  </div>

  <div>
    <label class="field-label" for="codigo_postal">
      Código postal <span class="text-cmykM">*</span>
    </label>
    {/* Cinco dígitos, que es el formato de todo México. `maxlength` y el script de
        `data-solo-digitos` impiden escribir otra cosa. `inputmode="numeric"`
        para el teclado de números; `pattern` solo dígitos, sin separadores,
        porque un CP nunca los lleva. */}
    <input
      class="field"
      id="codigo_postal"
      name="codigo_postal"
      type="text"
      required
      inputmode="numeric"
      autocomplete="postal-code"
      maxlength="5"
      pattern="[0-9]{5}"
      aria-describedby="ayuda-cp"
      data-solo-digitos="5"
      data-nombre-campo="El código postal"
      placeholder="79000"
    />
    <p id="ayuda-cp" class="mt-1.5 text-[13px] text-ash">5 dígitos. Ejemplo: 79000</p>
  </div>

  <div class="sm:col-span-2">
    <button type="submit" data-boton-enviar class="btn-brand w-full sm:w-auto">
      Enviar mis datos
    </button>
    {/* Quién llama y para qué ya lo dice el encabezado de la página o del
        modal; aquí solo cuándo, y la salida para quien no puede esperar. */}
    <p class="mt-3 text-[14px] leading-relaxed text-ash">
      Te llamamos en horario de tienda. ¿Es urgente? Llámanos al{' '}
      <a href={`tel:${PHONE_TEL}`} class="font-semibold text-brand underline underline-offset-2">
        {PHONE_DISPLAY}
      </a>
    </p>
  </div>
</form>

<script>
  // Copia los utm_* de la URL a los campos ocultos del formulario.
  //
  // Se guardan en sessionStorage porque el visitante de un anuncio puede
  // navegar dentro de la página antes de abrir el formulario, y en cuanto pasa
  // por un enlace interno los parámetros desaparecen de la barra. Sin esto se
  // pierde la atribución justo de los leads que más tardaron en decidirse.
  (() => {
    const CLAVE = 'reverte-utm';
    const CAMPOS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];

    let guardados: Record<string, string> = {};
    try {
      guardados = JSON.parse(sessionStorage.getItem(CLAVE) || '{}');
    } catch {
      /* modo privado o storage bloqueado: seguimos solo con la URL */
    }

    const params = new URLSearchParams(location.search);
    let hayNuevos = false;
    for (const campo of CAMPOS) {
      const v = params.get(campo);
      if (v) {
        guardados[campo] = v.slice(0, 160);
        hayNuevos = true;
      }
    }
    if (hayNuevos) {
      try {
        sessionStorage.setItem(CLAVE, JSON.stringify(guardados));
      } catch {
        /* da igual: los campos de esta página ya quedan rellenos */
      }
    }

    for (const input of document.querySelectorAll<HTMLInputElement>('[data-utm]')) {
      const campo = input.dataset.utm;
      if (campo && guardados[campo]) input.value = guardados[campo];
    }
  })();

  // Bloquea el botón en cuanto se manda el formulario: sin esto, un clic
  // doble (o alguien probando "a ver qué pasa si le doy varias veces")
  // dispara varios POST antes de que el servidor alcance a redirigir. Esto
  // es la mitad "de un clic" de la protección; la otra mitad, contra reenvíos
  // ya en otra carga de página, es la cookie de cooldown en /api/cotizar.
  document.querySelectorAll<HTMLFormElement>('[data-form-cotizar]').forEach((form) => {
    form.addEventListener('submit', () => {
      const boton = form.querySelector<HTMLButtonElement>('[data-boton-enviar]');
      if (!boton || boton.disabled) return;
      boton.disabled = true;
      boton.textContent = 'Enviando…';
    });
  });

  // Campos de solo dígitos con largo fijo: teléfono (10) y código postal (5).
  //
  // Dos cosas, en este orden:
  //   1. Filtrar al escribir: cualquier carácter que no sea número desaparece
  //      en el acto, y lo que pase del largo se corta. Cubre el teclado, el
  //      pegado ("481 381-6663" queda como 4813816663) y el autocompletado.
  //      Es lo que se pidió: que el campo no deje meter de más, no que avise
  //      después.
  //   2. Si quedan menos dígitos de los debidos, decir cuántos faltan con
  //      setCustomValidity: el navegador lo muestra en su propio globo y
  //      bloquea el envío, igual que hace con `required`, sin inventar una UI
  //      de errores aparte. `pattern` por sí solo diría "formato incorrecto",
  //      que no ayuda a saber qué corregir.
  document.querySelectorAll<HTMLInputElement>('[data-solo-digitos]').forEach((campo) => {
    const largo = Number(campo.dataset.soloDigitos) || 0;
    const nombre = campo.dataset.nombreCampo ?? 'Este campo';

    const revisar = () => {
      const limpio = campo.value.replace(/\D/g, '').slice(0, largo);
      if (limpio !== campo.value) campo.value = limpio;

      if (limpio === '') {
        // Vacío no es "faltan dígitos": de eso ya se queja `required` con su
        // propio mensaje, y pisarlo aquí sería contradecirlo.
        campo.setCustomValidity('');
      } else if (limpio.length < largo) {
        const faltan = largo - limpio.length;
        campo.setCustomValidity(
          `Faltan ${faltan} ${faltan === 1 ? 'dígito' : 'dígitos'}: ${nombre.toLowerCase()} debe tener ${largo}.`
        );
      } else {
        campo.setCustomValidity('');
      }
    };

    // `input` filtra y limpia el aviso en cuanto se corrige. `change` cubre
    // el autocompletado del navegador, que rellena sin que nadie escriba. NO
    // se revalida en el `submit`: la validación nativa corre ANTES de ese
    // evento, así que para entonces el navegador ya decidió.
    campo.addEventListener('input', revisar);
    campo.addEventListener('change', revisar);
    campo.addEventListener('blur', revisar);
    revisar();
  });
</script>
