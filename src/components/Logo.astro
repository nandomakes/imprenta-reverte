---
interface Props {
  /** `color` sobre fondo claro · `blanco` sobre fondos oscuros (footer azul). */
  tono?: 'color' | 'blanco';
  class?: string;
}
const { tono = 'color', class: clase = '' } = Astro.props;

// Dos archivos, no un filtro CSS: el logo con letras negras es el principal y
// solo se lee sobre fondo claro; sobre el azul del footer va el de letras
// blancas. El original es 1860×726 (310:121). Se sirve un WebP a 620×242,
// el mismo ratio, en vez del PNG de ~200–290 KB. width y height son los
// píxeles del archivo para que la caja no se deforme.
const src = tono === 'blanco' ? '/logo-letras-blancas.webp' : '/logo-letras-negras.webp';
---

<img
  src={src}
  alt="Imprenta Reverte"
  width="620"
  height="242"
  decoding="async"
  class={`h-11 w-auto shrink-0 sm:h-12 ${clase}`}
/>
