---
interface Props {
  /** `color` sobre fondo claro · `blanco` sobre fondos oscuros (footer azul). */
  tono?: 'color' | 'blanco';
  class?: string;
}
const { tono = 'color', class: clase = '' } = Astro.props;

// Dos archivos, no un filtro CSS: el logo con letras negras es el principal y
// solo se lee sobre fondo claro; sobre el azul del footer va el de letras
// blancas. El original mide 2051x767 (≈2.67:1); se sirve a alto fijo.
const src = tono === 'blanco' ? '/logo-letras-blancas.png' : '/logo-letras-negras.png';
---

<img
  src={src}
  alt="Imprenta Reverte"
  width="2051"
  height="767"
  decoding="async"
  class={`h-11 w-auto shrink-0 sm:h-12 ${clase}`}
/>
