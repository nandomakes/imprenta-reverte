---
/**
 * Botón flotante persistente + modal con el formulario de captura.
 *
 * Lo usan /promo y /bio. El formulario es el MISMO `QuoteForm` del sitio: no se
 * duplica ni el marcado ni el envío, solo cambia el `origen` con el que entra
 * el lead.
 *
 * Se apoya en `<dialog>` nativo: el atrapado de foco, el cierre con Escape y el
 * fondo inerte los da el navegador. Una implementación propia de todo eso sería
 * más código y peor accesibilidad.
 *
 * Si el JS no carga, el botón flotante es un ancla a `/cotizar/`: el visitante
 * de un anuncio pagado nunca se queda sin una forma de contactar.
 */
import QuoteForm from './QuoteForm.astro';

interface Props {
  /** De dónde sale el lead: `promo_meta_ads`, `bio_instagram`… */
  origen: string;
  /** Ruta a la que vuelve si la validación del servidor falla. */
  retorno: string;
  /** Texto del botón flotante. */
  etiqueta?: string;
}

const { origen, retorno, etiqueta = 'Pedir cotización' } = Astro.props;
---

{/* bottom-[calc(1rem+env(...))]: en un iPhone sin botón físico, 1rem a secas
    deja el botón demasiado cerca de la línea de gestos del home indicator.
    En Android o con botón físico env() vale 0 y queda igual que antes. */}
<a
  href="/cotizar/"
  data-abrir-lead
  class="btn-brand fixed bottom-[calc(1rem+env(safe-area-inset-bottom))] left-1/2 z-40 w-[calc(100%-2rem)] max-w-sm -translate-x-1/2 shadow-2xl sm:w-auto"
>
  {etiqueta}
</a>

<dialog
  data-lead-modal
  class="w-[min(680px,calc(100vw-1.5rem))] rounded-none bg-white p-0 backdrop:bg-brand/60"
  aria-labelledby="titulo-cotizar"
>
  <div class="max-h-[85vh] overflow-y-auto p-5 sm:p-7">
    <div class="mb-5 flex items-start justify-between gap-4">
      <div>
        <h2 id="titulo-cotizar" class="text-[22px] sm:text-[26px]">Pide tu cotización</h2>
        <p class="mt-1 text-[15px] text-ash">
          Cuéntanos qué necesitas y te pasamos precio. Sin compromiso.
        </p>
      </div>
      <button
        type="button"
        data-cerrar-lead
        class="-mr-1 -mt-1 shrink-0 p-2 text-ash transition-colors hover:text-ink"
        aria-label="Cerrar"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 5l14 14M19 5L5 19" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <QuoteForm compacto origen={origen} retorno={retorno} />
  </div>
</dialog>

<script>
  const modal = document.querySelector<HTMLDialogElement>('[data-lead-modal]');
  if (modal && typeof modal.showModal === 'function') {
    // Solo ahora el botón deja de ser un enlace: si llegamos aquí, hay JS y
    // `<dialog>` funciona. Hasta entonces sigue navegando a /cotizar/.
    document.querySelectorAll<HTMLAnchorElement>('[data-abrir-lead]').forEach((b) => {
      b.addEventListener('click', (e) => {
        e.preventDefault();
        modal.showModal();
      });
    });

    modal
      .querySelector('[data-cerrar-lead]')
      ?.addEventListener('click', () => modal.close());

    // Clic en el fondo: el evento sale del propio <dialog>, que ocupa solo la
    // caja. Si el punto del clic cae fuera de ella, es el backdrop.
    modal.addEventListener('click', (e) => {
      const c = modal.getBoundingClientRect();
      const fuera =
        e.clientX < c.left || e.clientX > c.right || e.clientY < c.top || e.clientY > c.bottom;
      if (fuera) modal.close();
    });

    // Si el servidor devolvió ?error=1, el visitante ya había abierto el modal:
    // se reabre solo para que no tenga que buscarlo otra vez.
    if (new URLSearchParams(location.search).get('error') === '1') modal.showModal();
  }
</script>
