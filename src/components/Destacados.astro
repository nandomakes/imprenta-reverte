---
import { DESTACADOS } from '../consts';
import Foto from './Foto.astro';
---

<section class="bg-mist">
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="kicker reveal">Lo más pedido</p>
        <h2 class="headline reveal mt-3 text-3xl text-ink sm:text-4xl">
          Los trabajos que más nos encargan
        </h2>
      </div>
      <a
        href="/catalogo/"
        class="reveal text-sm font-semibold text-brand underline underline-offset-4 hover:text-brandDk"
      >
        Ver el catálogo completo
      </a>
    </div>

    <ul class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        DESTACADOS.map((d) => (
          <li class="reveal">
            <a
              href={`/catalogo/${d.categoria}/`}
              class="zoom-parent lift group block overflow-hidden rounded-xl border border-line bg-white"
            >
              <div class="overflow-hidden">
                <Foto
                  id={d.imagen}
                  alt={d.alt}
                  ratio="1/1"
                  sizes="(min-width:768px) 280px, 45vw"
                  class="zoom-img"
                />
              </div>
              <p class="px-4 py-3.5 text-sm font-semibold text-ink group-hover:text-brand">
                {d.nombre}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
