---
// "Nuevas llegadas": tres mosaicos a sangre, sin margen entre ellos, que
// ocupan todo el ancho de la ventana.
import { MOSAICO } from '../consts';
import Foto from './Foto.astro';
---

<section class="py-12 md:py-16">
  <h2 class="h-sec reveal mb-8 text-center">Lo que más nos encargan</h2>
  <ul class="grid sm:grid-cols-3">
    {
      MOSAICO.map((m) => (
        <li>
          <a href={m.href} class="zoom-parent group relative block overflow-hidden">
            <Foto
              id={m.imagen}
              alt={m.alt}
              ratio="4/3"
              sizes="(min-width:640px) 33vw, 100vw"
              class="zoom-img"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 to-transparent" />
            <h3 class="absolute inset-x-0 bottom-0 p-5 text-[19px] font-semibold text-white sm:text-[20px]">
              {m.titulo}
            </h3>
          </a>
        </li>
      ))
    }
  </ul>
</section>
