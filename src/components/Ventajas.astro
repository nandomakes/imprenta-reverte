---
import { VENTAJAS } from '../consts';
---

<section class="border-y border-line bg-mist">
  <div class="mx-auto grid max-w-7xl gap-8 px-6 py-12 sm:grid-cols-2 lg:grid-cols-4">
    {
      VENTAJAS.map((v) => (
        <div class="reveal">
          <h3 class="font-display text-base font-bold text-ink">{v.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-char">{v.texto}</p>
        </div>
      ))
    }
  </div>
</section>
