---
import QuoteForm from './QuoteForm.astro';
import { PHONE_DISPLAY, PHONE_TEL, CONTACT, WHATSAPP_URL } from '../consts';

interface Props {
  /** Preselecciona la categoría cuando se entra desde una ficha. */
  categoria?: string;
  titulo?: string;
}

const {
  categoria,
  titulo = 'Cuéntanos qué necesitas y te cotizamos',
} = Astro.props;
---

<section id="cotizar" class="scroll-mt-24 bg-brand">
  <div class="mx-auto grid max-w-7xl gap-10 px-6 py-16 md:py-20 lg:grid-cols-[1fr_1.35fr]">
    <div class="text-white">
      <p class="kicker reveal text-white/70">Cotización sin compromiso</p>
      <h2 id="titulo-cotizar" class="headline reveal mt-3 text-3xl text-white sm:text-4xl">
        {titulo}
      </h2>
      <p class="reveal mt-4 text-lg leading-relaxed text-white/80">
        Llena el formulario con lo que tengas a la mano. Si aún no sabes medidas o cantidades, no
        importa: escríbenos y lo aterrizamos juntos.
      </p>

      <ul class="reveal mt-8 space-y-4 text-white/85">
        <li class="flex gap-3">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          <span>
            <strong class="font-semibold text-white">Por teléfono:</strong>{' '}
            <a href={`tel:${PHONE_TEL}`} class="underline underline-offset-4">{PHONE_DISPLAY}</a>
          </span>
        </li>
        <li class="flex gap-3">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          <span>
            <strong class="font-semibold text-white">Por WhatsApp:</strong>{' '}
            <a
              href={WHATSAPP_URL}
              target="_blank"
              rel="noopener"
              class="underline underline-offset-4">manda tu mensaje</a
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          <span>
            <strong class="font-semibold text-white">En persona:</strong> {CONTACT.addressLine},
            {CONTACT.locality}
          </span>
        </li>
      </ul>
    </div>

    <div class="reveal rounded-2xl bg-white p-6 shadow-xl shadow-ink/20 sm:p-8">
      <QuoteForm categoria={categoria} />
    </div>
  </div>
</section>
