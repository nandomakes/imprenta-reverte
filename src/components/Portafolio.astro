---
/**
 * Portafolio en grid "bento": una pieza grande (2×2) rodeada de 8 chicas, tal
 * como la retícula de referencia — 4 columnas, 3 filas, la pieza grande
 * ocupa las columnas 2-3 en las filas 1-2.
 *
 * Las fotos son de Unsplash (gratuitas, verificadas con curl 200 OK antes de
 * usarlas, ninguna de Unsplash+), estilo mockup de estudio minimalista con
 * fondo claro. NO son fotos de trabajos reales entregados a un cliente — eso
 * sigue pendiente de que el dueño suba sus propias fotos. Mientras tanto,
 * mostrar mockups genéricos es honesto: no pretenden ser un trabajo propio,
 * solo ilustran el tipo de pieza.
 *
 * Dos de las nueve REPITEN la foto de su categoría del catálogo
 * ('publicidad-exterior-gran-formato' y 'sellos'): tras varios intentos no
 * apareció ninguna foto gratuita de rotulación vehicular o sello que además
 * tuviera fondo claro y se viera profesional (las alternativas eran de noche,
 * en blanco y negro sobre madera oscura, o arte callejero improvisado). Se
 * prefirió repetir una foto ya buena a usar una que no cumpliera "minimalista
 * y fondo claro". Ver PENDIENTES.md.
 *
 * En móvil el bento no cabe (2×2 necesita ancho de escritorio para leerse):
 * se colapsa a una columna con las 9 piezas en el orden natural.
 */
import Foto from './Foto.astro';
import TituloFantasma from './TituloFantasma.astro';

const piezas = [
  {
    titulo: 'Invitaciones de evento',
    imagen: 'photo-1566125882500-87e10f726cdc',
    imagenAlt: 'Papelería de invitación blanca flat lay con sobre kraft sobre fondo claro',
    grande: false,
  },
  {
    titulo: 'Rotulación vehicular',
    imagen: 'photo-1580828343064-fde4fc206bc6',
    imagenAlt: 'Letras grandes de vinil adhesivo aplicadas sobre el aparador de un local',
    grande: true,
  },
  {
    titulo: 'Playeras con logo',
    imagen: 'photo-1651761179569-4ba2aa054997',
    imagenAlt: 'Playera blanca lisa de algodón en mockup de estudio sobre fondo blanco',
    grande: false,
  },
  {
    titulo: 'Tarjetas de presentación',
    imagen: 'photo-1623305463957-df17547327cb',
    imagenAlt: 'Par de tarjetas de presentación en blanco sobre fondo gris claro de estudio',
    grande: false,
  },
  {
    titulo: 'Sellos personalizados',
    imagen: 'photo-1562330094-4a3730591558',
    imagenAlt: 'Tijeras, un sello de goma y una tarjeta en blanco sobre madera clara',
    grande: false,
  },
  {
    titulo: 'Papelería corporativa',
    imagen: 'photo-1627618998627-70a92a874cc2',
    imagenAlt: 'Hojas de papel membretado en blanco sobre un sobre kraft, composición flat lay',
    grande: false,
  },
  {
    titulo: 'Tarjetas de presentación a color',
    imagen: 'photo-1623305466040-b753da413c9b',
    imagenAlt: 'Pila de tarjetas de presentación en blanco alineadas sobre fondo de estudio',
    grande: false,
  },
  {
    titulo: 'Revistas y folletos',
    imagen: 'photo-1621944192380-808416c390e2',
    imagenAlt: 'Folleto o revista en blanco abierto, mockup sobre fondo gris claro de estudio',
    grande: false,
  },
  {
    titulo: 'Etiquetas de producto',
    imagen: 'photo-1763667926453-6a992d38ac43',
    imagenAlt: 'Botella de producto con etiqueta blanca en blanco, estilo mockup',
    grande: false,
  },
];

// Posición explícita de cada celda en el bento de 4×3. Solo se aplica desde
// `lg`; antes de eso el grid cae a una columna y este mapa no se usa.
const posiciones = [
  'lg:col-start-1 lg:row-start-1',
  'lg:col-start-2 lg:col-span-2 lg:row-start-1 lg:row-span-2', // la grande
  'lg:col-start-4 lg:row-start-1',
  'lg:col-start-1 lg:row-start-2',
  'lg:col-start-4 lg:row-start-2',
  'lg:col-start-1 lg:row-start-3',
  'lg:col-start-2 lg:row-start-3',
  'lg:col-start-3 lg:row-start-3',
  'lg:col-start-4 lg:row-start-3',
];
---

<section class="relative overflow-hidden bg-paper py-16 md:py-24">
  <div class="shell relative">
    <div class="mx-auto max-w-2xl text-center">
      <TituloFantasma fantasma="Portafolio" eyebrow="Impresos" />
      <h2 class="reveal -mt-1 text-[30px] leading-tight text-ink sm:-mt-2 sm:text-[38px] lg:text-[42px]">
        Nada nos hace más felices, que imprimir para ti
      </h2>
      <p class="reveal mx-auto mt-4 max-w-lg text-[16px] leading-relaxed text-ash">
        Desde una tarjeta de presentación hasta el kit completo para un evento grande: todos son
        trabajos que nos importan.
      </p>
    </div>

    {/* Cada fila mide lo que mide un cuadro chico (aspect-square), porque
        ninguna fila tiene una altura fija: la toma del contenido. La pieza
        grande ocupa 2 columnas y, siendo también aspect-square, su alto
        resulta ser exactamente el de dos filas chicas apiladas — así calza
        con la retícula sin tener que fijar alturas a mano. */}
    <ul class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        piezas.map((p, i) => (
          <li
            class:list={[
              'reveal group relative aspect-square overflow-hidden bg-white',
              p.grande && 'col-span-2',
              posiciones[i],
            ]}
          >
            <Foto
              id={p.imagen}
              alt={p.imagenAlt}
              ratio="1/1"
              sizes={p.grande ? '(min-width:1024px) 640px, 100vw' : '(min-width:1024px) 320px, 50vw'}
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-3 pt-8">
              <p class={`font-semibold text-white ${p.grande ? 'text-[17px]' : 'text-[13px]'}`}>
                {p.titulo}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
