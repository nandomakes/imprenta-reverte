---
// "Diseñe su estilo de firma en 3 maneras!" — sección gris con tres tarjetas
// (título azul + texto arriba, imagen pastel abajo) y un botón azul centrado.
import { TRES_MANERAS, CTA_LABEL } from '../consts';
import Foto from './Foto.astro';

const tonos: Record<string, string> = {
  card1: 'bg-card1',
  card2: 'bg-card2',
  card3: 'bg-card3',
  card4: 'bg-card4',
};
---

<section id="tres-maneras" class="bg-paper py-12 md:py-16 lg:py-20">
  <div class="shell">
    <h2 class="h-sec reveal mb-8 max-w-3xl lg:mb-10 lg:text-center lg:mx-auto">
      Diseña tu impreso de 3 maneras
    </h2>

    <ul class="rail lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible">
      {
        TRES_MANERAS.map((m) => (
          <li class="flex w-[300px] flex-col bg-white sm:w-[340px] lg:w-auto">
            <div class="flex-1 p-6 lg:p-7">
              <h3 class="text-[20px] font-semibold text-brand lg:text-[22px]">{m.titulo}</h3>
              <p class="mt-3 text-[15px] leading-relaxed">{m.texto}</p>
            </div>
            <div class={tonos[m.tono] ?? 'bg-paper'}>
              <Foto
                id={m.imagen}
                alt={m.alt}
                ratio="16/10"
                sizes="(min-width:1024px) 420px, 320px"
              />
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-9 lg:text-center">
      <a href="/catalogo/" class="btn-brand reveal">Ver todo el catálogo</a>
      <a href="/cotizar/" class="btn-brand reveal ml-0 mt-3 sm:ml-3 sm:mt-0">{CTA_LABEL}</a>
    </div>
  </div>
</section>
