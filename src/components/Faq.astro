---
interface Props {
  items: readonly { q: string; a: string }[];
  titulo?: string;
}

const { items, titulo = 'Preguntas frecuentes' } = Astro.props;
---

<section class="bg-white">
  <div class="mx-auto max-w-3xl px-6 py-16 md:py-20">
    <p class="kicker reveal">Dudas</p>
    <h2 class="headline reveal mt-3 text-3xl text-ink sm:text-4xl">{titulo}</h2>

    <div class="mt-8 divide-y divide-line border-y border-line">
      {
        items.map((f) => (
          <details class="faq reveal group py-1">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-left font-semibold text-ink hover:text-brand">
              <span>{f.q}</span>
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="mt-1 h-5 w-5 shrink-0 text-brand transition-transform duration-300 group-open:rotate-45"
              >
                <path d="M10 4v12M4 10h12" />
              </svg>
            </summary>
            <p class="pb-5 pr-9 leading-relaxed text-char">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
