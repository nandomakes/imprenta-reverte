---
interface Props {
  items: readonly { q: string; a: string }[];
  titulo?: string;
  fondo?: 'blanco' | 'mist';
}

const { items, titulo = 'Preguntas frecuentes', fondo = 'blanco' } = Astro.props;
---

<section class={fondo === 'mist' ? 'bg-mist py-12 md:py-16' : 'bg-white py-12 md:py-16'}>
  <div class="shell max-w-3xl">
    <h2 class="h-sec reveal text-center">{titulo}</h2>

    <div class="mt-9 divide-y divide-line border-y border-line">
      {
        items.map((f) => (
          <details class="faq reveal group">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-left text-[16px] font-semibold text-ink hover:text-brand">
              <span>{f.q}</span>
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="mt-1 h-5 w-5 shrink-0 text-brand transition-transform duration-300 group-open:rotate-45"
              >
                <path d="M10 4v12M4 10h12" />
              </svg>
            </summary>
            <p class="pb-5 pr-9 text-[15px] leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
