---
// Cabecera de página interior: migas + título, sobre la banda gris clara que
// la referencia usa en todas sus páginas que no son el home.
interface Props {
  titulo: string;
  intro?: string;
  migas: { label: string; href?: string }[];
}

const { titulo, intro, migas } = Astro.props;
---

<section class="border-b border-line bg-mist py-9 md:py-12">
  <div class="shell">
    <nav aria-label="Ruta" class="text-[14px] text-ash">
      <ol class="flex flex-wrap items-center gap-x-2">
        {
          migas.map((m, i) => (
            <li class="flex items-center gap-2">
              {m.href ? (
                <a href={m.href} class="hover:text-brand">
                  {m.label}
                </a>
              ) : (
                <span class="text-ink">{m.label}</span>
              )}
              {i < migas.length - 1 && <span aria-hidden="true">/</span>}
            </li>
          ))
        }
      </ol>
    </nav>
    <h1 class="mt-3 text-[30px] font-semibold leading-tight text-ink sm:text-[36px] lg:text-[42px]">
      {titulo}
    </h1>
    {intro && <p class="mt-4 max-w-2xl text-[16px] leading-relaxed">{intro}</p>}
  </div>
</section>
