---
import { PASOS } from '../consts';
import Cta from './Cta.astro';
---

<section class="dot-bg bg-white">
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
    <div class="max-w-2xl">
      <p class="kicker reveal">Cómo trabajamos</p>
      <h2 class="headline reveal mt-3 text-3xl text-ink sm:text-4xl">
        Diseña tu impreso en tres pasos
      </h2>
      <p class="reveal mt-4 text-lg leading-relaxed text-char">
        Traes tu diseño, lo hacemos contigo o partimos de una plantilla. En los tres casos el
        proceso es el mismo y siempre termina con tu aprobación antes de imprimir.
      </p>
    </div>

    <ol class="mt-12 grid gap-8 md:grid-cols-3">
      {
        PASOS.map((p) => (
          <li class="reveal relative rounded-xl border border-line bg-white p-7">
            <span
              class="font-display text-5xl font-bold leading-none text-brandLt"
              aria-hidden="true"
            >
              {p.numero}
            </span>
            <h3 class="mt-3 font-display text-xl font-bold text-ink">{p.titulo}</h3>
            <p class="mt-2.5 leading-relaxed text-char">{p.texto}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-10">
      <Cta href="/contacto/#cotizar" tamano="lg" />
    </div>
  </div>
</section>
