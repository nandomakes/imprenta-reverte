---
// "Voces de la delicia": título centrado con subtítulo, tarjetas con borde
// fino, nombre en azul y comillas grandes en la esquina, con flechas.
import { TESTIMONIOS, CONTACT } from '../consts';
import TituloFantasma from './TituloFantasma.astro';
---

<section class="relative overflow-hidden bg-white py-16 md:py-24">
  <div class="shell" data-carrusel>
    <div class="mx-auto max-w-2xl text-center">
      <TituloFantasma fantasma="Reseñas" eyebrow="Reseñas" />
      <h2 class="reveal -mt-1 text-[30px] leading-tight text-ink sm:-mt-2 sm:text-[38px] lg:text-[42px]">
        Lo que dicen de nosotros
      </h2>
      <p class="reveal mt-2 text-[15px] text-ash">¡Testimonios de clientes reales!</p>
      <a
        href={CONTACT.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal mt-2 inline-block text-[13px] font-semibold text-brand underline underline-offset-2"
      >
        Ver reseñas en Google
      </a>
    </div>

    <div class="relative mt-10">
      <ul class="rail">
        {
          TESTIMONIOS.map((t) => (
            <li class="relative flex w-[290px] flex-col border border-line p-7 sm:w-[360px] lg:w-[400px]">
              <blockquote class="flex-1 text-[15px] leading-relaxed">{t.texto}</blockquote>
              <footer class="mt-6">
                <p class="text-[16px] font-semibold text-brand">{t.autor}</p>
                <p class="text-[13px] text-ash">{t.rol}</p>
              </footer>
              <svg
                viewBox="0 0 40 30"
                class="absolute bottom-6 right-6 h-7 w-9 text-brand/15"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M0 30V16C0 7 5 1 15 0v6c-5 1-7 4-7 8h7v16zm22 0V16c0-9 5-15 15-16v6c-5 1-7 4-7 8h7v16z" />
              </svg>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
