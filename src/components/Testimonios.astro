---
// "Voces de la delicia": título centrado con subtítulo, tarjetas con borde
// fino, nombre en azul y comillas grandes en la esquina, con flechas.
import { TESTIMONIOS } from '../consts';
---

<section class="bg-white py-12 md:py-16 lg:py-20">
  <div class="shell" data-carrusel>
    <div class="text-center">
      <h2 class="h-sec reveal">Lo que dicen de nosotros</h2>
      <p class="reveal mt-2 text-[15px] text-ash">¡Testimonios de clientes reales!</p>
    </div>

    <div class="relative mt-10">
      <ul class="rail">
        {
          TESTIMONIOS.map((t) => (
            <li class="relative flex w-[290px] flex-col border border-line p-7 sm:w-[360px] lg:w-[400px]">
              <blockquote class="flex-1 text-[15px] leading-relaxed">{t.texto}</blockquote>
              <footer class="mt-6">
                <p class="text-[16px] font-semibold text-brand">{t.autor}</p>
                <p class="text-[13px] text-ash">{t.rol}</p>
              </footer>
              <svg
                viewBox="0 0 40 30"
                class="absolute bottom-6 right-6 h-7 w-9 text-brand/15"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M0 30V16C0 7 5 1 15 0v6c-5 1-7 4-7 8h7v16zm22 0V16c0-9 5-15 15-16v6c-5 1-7 4-7 8h7v16z" />
              </svg>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        data-prev
        class="arrow absolute -left-2 top-1/2 hidden -translate-y-1/2 lg:grid"
        aria-label="Anterior"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button
        type="button"
        data-next
        class="arrow absolute -right-2 top-1/2 hidden -translate-y-1/2 lg:grid"
        aria-label="Siguiente"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
</section>
