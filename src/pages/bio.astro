---
/**
 * Página de bio, tipo Linktree — destino del enlace en Instagram y Facebook.
 *
 * PARA QUÉ EXISTE: que la persona deje su teléfono. Todo lo demás (catálogo,
 * redes, mapa) es el camino para llegar ahí; la venta la cierra un asesor
 * llamando después. Por eso la tarjeta de datos va arriba y aparte de la
 * lista, y por eso aquí NO hay WhatsApp: un chat suelto se lleva el lead
 * fuera del formulario y nadie lo registra.
 *
 * PARA QUIÉN: público que llega desde Instagram sin contexto y en buena
 * parte mayor de 50. De ahí las decisiones de forma —
 *   - una pregunta que invita ("¿Qué te gustaría imprimir?") en vez de un
 *     eslogan, y la instrucción "Toca una opción" con el verbo explícito;
 *   - flecha › en cada botón, la señal de "esto lleva a otro lado" que ya
 *     conocen de WhatsApp y de los Ajustes del teléfono;
 *   - texto de 17px y botones de 60px, para leer y atinar;
 *   - la tarjeta de datos dice abiertamente que van a llamar.
 *
 * Los nombres de los rubros del catálogo también se adaptaron a este
 * público: ver `labelBio` en NAV.
 *
 * Origen del lead: `?ref=fb` lo marca como `bio_facebook`; por defecto es
 * `bio_instagram`. Lo resuelve BioOrigen en el cliente y lo recuerda por el
 * resto del flujo, porque la página es estática.
 */
import Layout from '../layouts/Layout.astro';
import LeadModal from '../components/LeadModal.astro';
import Diana from '../components/Diana.astro';
import BioBoton from '../components/BioBoton.astro';
import BioLeadCard from '../components/BioLeadCard.astro';
import BioOrigen from '../components/BioOrigen.astro';
import { SITE, CONTACT, SOCIALS, PHONE_TEL, PHONE_DISPLAY } from '../consts';

const ORIGEN = 'bio_instagram';
const RETORNO = '/bio/';

const instagram = SOCIALS.find((s) => s.icon === 'instagram');
const facebook = SOCIALS.find((s) => s.icon === 'facebook');

// Dos grupos, por jerarquía. Arriba lo que lleva a vender: el catálogo, cómo
// llegar y el sitio. Abajo, en una sola fila de dos, las redes: quien llega
// aquí desde un anuncio de Instagram o Facebook ya está en esa red, así que
// darles una caja entera a cada una era gastar el espacio que necesita la
// tarjeta de datos para asomar en pantallas chicas.
//
// El primero es el formulario (oct 2026): la mitad del tráfico de la bio llega
// de un anuncio y no debe tener que bajar hasta la tarjeta para dejar sus
// datos. La tarjeta de abajo se queda: explica que lo van a llamar, para
// quien no se decide con un botón. Con JS abre el modal; sin JS, /cotizar/.
const enlaces = [
  { emoji: '📝', texto: 'Quiero mi cotización', href: '/cotizar/', externo: false, formulario: true },
  { emoji: '📖', texto: 'Ver el catálogo', href: '/bio/catalogo/', externo: false },
  { emoji: '📍', texto: 'Cómo llegar', href: CONTACT.mapsUrl, externo: true },
  { emoji: '🌐', texto: 'Sitio web', href: '/', externo: false },
];

const redes = [
  { emoji: '📸', texto: 'Instagram', href: instagram?.href ?? '#' },
  { emoji: '👍', texto: 'Facebook', href: facebook?.href ?? '#' },
];
---

<Layout
  title={`${SITE.brand} — Enlaces`}
  description={`Catálogo, redes y ubicación de ${SITE.brand} en ${CONTACT.locality}.`}
  noindex
  sinWhatsApp
>
  <main id="contenido" class="flex min-h-svh flex-col items-center bg-paper px-5 py-6">
    <div class="w-full max-w-md">
      <div class="text-center">
        <img
          src="/logo-letras-negras-480.webp"
          alt={SITE.brand}
          width="480"
          height="187"
          fetchpriority="high"
          class="mx-auto h-14 w-auto"
        />
        <p class="mt-2 text-[16px] text-ash">Imprenta en {CONTACT.locality}, SLP</p>
        <Diana variante="separador" tam={16} class="mx-auto mt-4 max-w-[220px] text-ash" />
      </div>

      <div class="mt-5 text-center">
        <h1 class="text-[27px] font-semibold leading-tight text-ink">¿Qué te gustaría imprimir?</h1>
        <p class="mt-2 text-[18px] text-ash">Toca una opción para continuar</p>
      </div>

      <nav class="mt-4" aria-label="Enlaces de Imprenta Reverte">
        <ul class="grid gap-2.5">
          {
            enlaces.map((e) => (
              <li>
                <BioBoton
                  href={e.href}
                  texto={e.texto}
                  emoji={e.emoji}
                  externo={e.externo}
                  abreFormulario={e.formulario}
                  destacado={e.formulario}
                />
              </li>
            ))
          }
          <li class="grid grid-cols-2 gap-2.5">
            {redes.map((r) => (
              <BioBoton href={r.href} texto={r.texto} emoji={r.emoji} externo compacto />
            ))}
          </li>
        </ul>
      </nav>

      <div class="mt-5">
        <BioLeadCard />
      </div>

      <p class="mt-8 text-center text-[16px] leading-relaxed text-ash">
        {CONTACT.addressFull}<br />
        {CONTACT.hoursText}<br />
        <a href={`tel:${PHONE_TEL}`} class="font-semibold text-brand underline underline-offset-2">
          {PHONE_DISPLAY}
        </a>
      </p>

      <div class="h-[env(safe-area-inset-bottom)]" aria-hidden="true"></div>
    </div>
  </main>

  <LeadModal origen={ORIGEN} retorno={RETORNO} etiqueta="Déjanos tus datos" sinBotonFlotante />
  <BioOrigen />
</Layout>

