---
/**
 * Segundo escalón: dado un rubro (p. ej. "Papelería"), lista sus
 * subcategorías REALES del catálogo en PDF — p. ej. "Notas y Formatos para
 * Negocio", "Papelería Médica y de Laboratorio", "Papelería Corporativa",
 * "Papelería Complementaria" — tal como vienen en `CATALOGO_PDF`.
 *
 * Cada botón abre su PDF directo en pestaña nueva
 * (`/catalogo-pdf/<archivo>.pdf`): ya no hay un tercer escalón ni página
 * intermedia — el PDF ES la imagen de esa sección que se había dejado
 * pendiente. Ver PENDIENTES.md.
 */
import Layout from '../../../../layouts/Layout.astro';
import LeadModal from '../../../../components/LeadModal.astro';
import Diana from '../../../../components/Diana.astro';
import { SITE, CONTACT, PHONE_TEL, PHONE_DISPLAY, NAV, CATALOGO_PDF } from '../../../../consts';

export function getStaticPaths() {
  return NAV.filter((r) => r.slug && r.slug !== 'todo').map((rubro) => ({
    params: { rubro: rubro.slug },
    props: { rubro },
  }));
}

interface Props {
  rubro: (typeof NAV)[number];
}

const { rubro } = Astro.props;

const ORIGEN = 'bio_instagram';
const RETORNO = `/bio/catalogo/${rubro.slug}/`;

const subcategorias = CATALOGO_PDF[rubro.slug ?? ''] ?? [];
---

<Layout
  title={`${rubro.label} | Catálogo | ${SITE.brand}`}
  description={`Subcategorías de ${rubro.label} en el catálogo de ${SITE.brand}, ${CONTACT.locality}.`}
  noindex
>
  <main id="contenido" class="flex min-h-svh flex-col items-center bg-paper px-5 py-10">
    <div class="w-full max-w-md">
      <div class="text-center">
        <img
          src="/logo-letras-negras.png"
          alt={SITE.brand}
          width="1860"
          height="726"
          class="mx-auto h-14 w-auto"
        />
        <p class="mt-5 text-[17px] font-semibold text-ink">{rubro.label}</p>
        <Diana variante="separador" tam={16} class="mx-auto mt-6 max-w-[220px] text-ash" />
      </div>

      <nav class="mt-8" aria-label={`Subcategorías de ${rubro.label}`}>
        <ul class="grid gap-3">
          {
            subcategorias.map((c) => (
              <li>
                <a
                  href={`/catalogo-pdf/${c.archivo}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex min-h-[56px] w-full items-center justify-center border border-line bg-white px-5 py-3.5 text-center text-[15px] font-medium text-ink transition-colors hover:border-brand"
                >
                  {c.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="mt-8 text-center">
        <a href="/bio/catalogo/" class="text-[14px] font-semibold text-brand underline underline-offset-2">
          ← Volver a rubros
        </a>
      </p>

      <p class="mt-6 text-center text-[14px] leading-relaxed text-ash">
        {CONTACT.addressFull}<br />
        {CONTACT.hoursText}<br />
        <a href={`tel:${PHONE_TEL}`} class="font-semibold text-brand underline underline-offset-2">
          {PHONE_DISPLAY}
        </a>
      </p>

      <div class="h-[calc(5rem+env(safe-area-inset-bottom))]" aria-hidden="true"></div>
    </div>
  </main>

  <LeadModal origen={ORIGEN} retorno={RETORNO} etiqueta="Pide tu cotización" />
</Layout>
