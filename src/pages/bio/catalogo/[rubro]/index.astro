---
/**
 * Segundo escalón: dado un rubro, lista sus subcategorías reales del PDF.
 * Cada botón abre su PDF en pestaña nueva — el ícono de documento avisa que
 * eso es lo que pasa, para que nadie se sorprenda con un archivo.
 *
 * Este es el momento en que la persona YA vio lo que vende la imprenta, así
 * que aquí la tarjeta de datos pesa más que en las otras páginas: viene
 * inmediatamente después de la lista, con la pregunta que corresponde a ese
 * momento ("¿Viste algo que te interese?") y la promesa clara de que un
 * asesor llama. Es el cierre del embudo de la bio.
 *
 * Sin WhatsApp aquí tampoco: el lead debe quedar registrado en el formulario.
 */
import Layout from '../../../../layouts/Layout.astro';
import LeadModal from '../../../../components/LeadModal.astro';
import Diana from '../../../../components/Diana.astro';
import BioBoton from '../../../../components/BioBoton.astro';
import BioLeadCard from '../../../../components/BioLeadCard.astro';
import { SITE, CONTACT, PHONE_TEL, PHONE_DISPLAY, NAV, CATALOGO_PDF } from '../../../../consts';

export function getStaticPaths() {
  return NAV.filter((r) => r.slug && r.slug !== 'todo').map((rubro) => ({
    params: { rubro: rubro.slug },
    props: { rubro },
  }));
}

interface Props {
  rubro: (typeof NAV)[number];
}

const { rubro } = Astro.props;
const nombre = rubro.labelBio ?? rubro.label;

const ORIGEN = 'bio_instagram';
const RETORNO = `/bio/catalogo/${rubro.slug}/`;

const subcategorias = CATALOGO_PDF[rubro.slug ?? ''] ?? [];
---

<Layout
  title={`${nombre} | Catálogo | ${SITE.brand}`}
  description={`Subcategorías de ${nombre} en el catálogo de ${SITE.brand}, ${CONTACT.locality}.`}
  noindex
  sinWhatsApp
>
  <main id="contenido" class="flex min-h-svh flex-col items-center bg-paper px-5 py-10">
    <div class="w-full max-w-md">
      <div class="text-center">
        <img
          src="/logo-letras-negras.png"
          alt={SITE.brand}
          width="1860"
          height="726"
          class="mx-auto h-14 w-auto"
        />
        <Diana variante="separador" tam={16} class="mx-auto mt-5 max-w-[220px] text-ash" />
      </div>

      <div class="mt-7 text-center">
        <h1 class="text-[24px] leading-tight text-ink">{nombre}</h1>
        <p class="mt-1.5 text-[16px] text-ash">Toca una opción para ver ese catálogo</p>
      </div>

      <nav class="mt-5" aria-label={`Subcategorías de ${nombre}`}>
        <ul class="grid gap-3">
          {
            subcategorias.map((c) => (
              <li>
                <BioBoton href={`/catalogo-pdf/${c.archivo}`} texto={c.titulo} externo tipo="documento" />
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-6">
        <BioLeadCard
          titulo="¿Viste algo que te interese?"
          texto="Déjanos tu número y un asesor te llama para cotizarte, sin compromiso."
        />
      </div>

      <p class="mt-8 text-center">
        <a href="/bio/catalogo/" class="text-[16px] font-semibold text-brand underline underline-offset-2">
          ← Volver a las opciones
        </a>
      </p>

      <p class="mt-6 text-center text-[15px] leading-relaxed text-ash">
        {CONTACT.addressFull}<br />
        {CONTACT.hoursText}<br />
        <a href={`tel:${PHONE_TEL}`} class="font-semibold text-brand underline underline-offset-2">
          {PHONE_DISPLAY}
        </a>
      </p>

      <div class="h-[env(safe-area-inset-bottom)]" aria-hidden="true"></div>
    </div>
  </main>

  <LeadModal origen={ORIGEN} retorno={RETORNO} etiqueta="Déjanos tus datos" sinBotonFlotante />
</Layout>
