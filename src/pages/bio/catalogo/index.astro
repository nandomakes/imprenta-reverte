---
/**
 * "Parte 2" de la bio: reparte hacia los 6 rubros del catálogo. Mismo estilo
 * y mismo público que /bio/ (ver ese archivo para el porqué de la forma).
 *
 * Escalones del flujo:
 *   /bio/catalogo/          → 6 rubros (esta página)
 *   /bio/catalogo/<rubro>/  → subcategorías reales del PDF, cada una abre su PDF
 *
 * Los rubros son los de `NAV`, pero con `labelBio` cuando el cliente pidió
 * un nombre más llano para este público ("Lonas y microperforados" en vez
 * de "Gran formato"). Sin WhatsApp: el lead debe quedar en el formulario.
 */
import Layout from '../../../layouts/Layout.astro';
import LeadModal from '../../../components/LeadModal.astro';
import Diana from '../../../components/Diana.astro';
import BioBoton from '../../../components/BioBoton.astro';
import BioLeadCard from '../../../components/BioLeadCard.astro';
import BioOrigen from '../../../components/BioOrigen.astro';
import { SITE, CONTACT, PHONE_TEL, PHONE_DISPLAY, NAV } from '../../../consts';

const ORIGEN = 'bio_instagram';
const RETORNO = '/bio/catalogo/';

// El primer elemento de NAV es "Todo el catálogo", no un rubro: se salta.
const rubros = NAV.slice(1);
---

<Layout
  title={`Catálogo | ${SITE.brand} — Enlaces`}
  description={`Elige un rubro del catálogo de ${SITE.brand} en ${CONTACT.locality}.`}
  noindex
  sinWhatsApp
>
  <main id="contenido" class="flex min-h-svh flex-col items-center bg-paper px-5 py-10">
    <div class="w-full max-w-md">
      <div class="text-center">
        <img
          src="/logo-letras-negras.png"
          alt={SITE.brand}
          width="1860"
          height="726"
          class="mx-auto h-14 w-auto"
        />
        <Diana variante="separador" tam={16} class="mx-auto mt-5 max-w-[220px] text-ash" />
      </div>

      <div class="mt-7 text-center">
        <h1 class="text-[24px] leading-tight text-ink">¿Qué te gustaría imprimir?</h1>
        <p class="mt-1.5 text-[16px] text-ash">Toca una opción para ver el catálogo</p>
      </div>

      <nav class="mt-5" aria-label="Rubros del catálogo">
        <ul class="grid gap-3">
          {
            rubros.map((r) => (
              <li>
                <BioBoton href={`/bio/catalogo/${r.slug}/`} texto={r.labelBio ?? r.label} />
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-6">
        <BioLeadCard
          titulo="¿No encuentras lo que buscas?"
          texto="Déjanos tu número y un asesor te llama para orientarte, sin compromiso."
        />
      </div>

      <p class="mt-8 text-center">
        <a href="/bio/" class="text-[16px] font-semibold text-brand underline underline-offset-2">
          ← Volver al inicio
        </a>
      </p>

      <p class="mt-6 text-center text-[15px] leading-relaxed text-ash">
        {CONTACT.addressFull}<br />
        {CONTACT.hoursText}<br />
        <a href={`tel:${PHONE_TEL}`} class="font-semibold text-brand underline underline-offset-2">
          {PHONE_DISPLAY}
        </a>
      </p>

      <div class="h-[env(safe-area-inset-bottom)]" aria-hidden="true"></div>
    </div>
  </main>

  <LeadModal origen={ORIGEN} retorno={RETORNO} etiqueta="Déjanos tus datos" sinBotonFlotante />
  <BioOrigen />
</Layout>
