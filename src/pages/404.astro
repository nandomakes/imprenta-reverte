---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallFab from '../components/CallFab.astro';
import Carrusel from '../components/Carrusel.astro';
import { PHONE_DISPLAY, PHONE_TEL, SITE } from '../consts';
---

<Layout
  title={`Página no encontrada | ${SITE.brand}`}
  description="La página que buscas no existe."
  noindex
>
  <Header />
  <main id="contenido">
    <section class="bg-paper py-16 md:py-24">
      <div class="shell max-w-2xl text-center">
        <p class="text-[64px] font-bold leading-none text-brand/20 sm:text-[80px]">404</p>
        <h1 class="mt-3 text-[28px] text-ink sm:text-[36px]">
          Esta página no existe
        </h1>
        <p class="mt-5 text-[16px] leading-relaxed">
          Puede que el enlace esté mal escrito o que hayamos movido la página. Prueba desde el
          catálogo, o llámanos al{' '}
          <a href={`tel:${PHONE_TEL}`} class="font-semibold text-brand underline underline-offset-4">
            {PHONE_DISPLAY}
          </a>.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/" class="btn-brand">Volver al inicio</a>
          <a href="/catalogo/" class="btn-accent">Ver el catálogo</a>
        </div>
      </div>
    </section>

    <Carrusel titulo="Quizá buscabas alguna de estas" />
  </main>
  <Footer />
  <CallFab />
</Layout>
