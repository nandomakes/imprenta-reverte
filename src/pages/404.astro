---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CATEGORIAS, PHONE_DISPLAY, PHONE_TEL, SITE } from '../consts';
---

<Layout
  title={`Página no encontrada | ${SITE.brand}`}
  description="La página que buscas no existe."
  noindex
>
  <Header />
  <main id="contenido" class="bg-mist">
    <div class="mx-auto max-w-2xl px-6 py-20 text-center md:py-28">
      <p class="font-display text-6xl font-bold text-brandLt">404</p>
      <h1 class="headline mt-4 text-3xl text-ink sm:text-4xl">Esta página no existe</h1>
      <p class="mt-5 text-lg leading-relaxed text-char">
        Puede que el enlace esté mal escrito o que hayamos movido la página. Prueba desde el
        catálogo, o llámanos al{' '}
        <a href={`tel:${PHONE_TEL}`} class="font-semibold text-brand underline underline-offset-4">
          {PHONE_DISPLAY}
        </a>.
      </p>

      <ul class="mt-9 flex flex-wrap justify-center gap-2">
        {
          CATEGORIAS.map((c) => (
            <li>
              <a
                href={`/catalogo/${c.slug}/`}
                class="inline-block rounded-full border border-line bg-white px-3.5 py-1.5 text-sm text-char transition-colors hover:border-brand hover:text-brand"
              >
                {c.etiqueta}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href="/"
        class="pressable mt-9 inline-flex items-center justify-center rounded-lg bg-brand px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-brandDk"
      >
        Volver al inicio
      </a>
    </div>
  </main>
  <Footer />
</Layout>
