---
// Equivale a /quote_create.php de la referencia: la página dedicada a
// solicitar una cotización.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallFab from '../components/CallFab.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import PageHead from '../components/PageHead.astro';
import Faq from '../components/Faq.astro';
import { FAQS_HOME, PHONE_DISPLAY, PHONE_TEL, SITE, faqPageSchema } from '../consts';

const title = `Solicitar una cotización | ${SITE.brand}`;
const description =
  'Déjanos tus datos y un asesor de Imprenta Reverte en Ciudad Valles, SLP, se contacta contigo para cotizarte. Sin compromiso.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Solicitar cotización', item: `${SITE.url}/cotizar/` },
  ],
};
---

<Layout title={title} description={description} schema={[breadcrumb, faqPageSchema(FAQS_HOME)]}>
  <Header />
  <main id="contenido">
    <PageHead
      titulo="Solicitar una cotización"
      intro="Sin compromiso y sin costo. Un asesor de ventas se contacta contigo en horario de tienda."
      migas={[{ label: 'Inicio', href: '/' }, { label: 'Solicitar cotización' }]}
    />

    <QuoteCTA titulo="Déjanos tus datos">
      {/* El endpoint devuelve aquí con ?error=1 cuando faltan campos
          obligatorios o el teléfono o el código postal no tienen el largo correcto. Se descubre en el cliente
          para que la página siga siendo estática y cacheable.
          Va dentro de QuoteCTA (slot "aviso"), no en un bloque blanco antes
          de la sección: así no deja un hueco de otro color cuando está
          oculto, que es lo que pasaba antes. */}
      <p
        id="aviso-error"
        role="alert"
        hidden
        slot="aviso"
        class="border-l-4 border-accent bg-white px-5 py-4 text-[15px] leading-relaxed"
      >
        No pudimos enviar tu solicitud: revisa que estén llenos tu nombre y tu ciudad, que el
        teléfono tenga los 10 dígitos con lada y el código postal sus 5 dígitos. Si sigue fallando, llámanos al{' '}
        <a href={`tel:${PHONE_TEL}`} class="font-semibold text-brand underline underline-offset-4">
          {PHONE_DISPLAY}
        </a>.
      </p>
    </QuoteCTA>
    <Faq items={FAQS_HOME} titulo="Antes de pedir tu cotización" />
  </main>
  <Footer />
  <CallFab />
</Layout>

<script>
  if (new URLSearchParams(location.search).get('error') === '1') {
    const aviso = document.getElementById('aviso-error');
    if (aviso) aviso.hidden = false;
  }
</script>
