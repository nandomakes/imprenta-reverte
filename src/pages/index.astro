---
// Rediseño compacto, inspirado en la estructura de colorciti.com.mx:
// hero → nosotros → servicios → portafolio → proceso (mapa) → reseñas →
// marcas que confían → formulario → mapa → footer.
//
// Reemplaza al orden anterior (calcado de printshopsolution.com/es/, con tres
// carruseles de producto, dos paneles promo, banda de distintivos y mosaico a
// sangre). Esos componentes se quedan en el repo sin usar, por si conviene
// reaprovechar alguno — el carrusel de producto, por ejemplo, encajaría bien
// en un futuro "portafolio" con fotos reales.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Experiencia from '../components/Experiencia.astro';
import Servicios from '../components/Servicios.astro';
import Portafolio from '../components/Portafolio.astro';
import Proceso from '../components/Proceso.astro';
import Testimonios from '../components/Testimonios.astro';
import Giros from '../components/Giros.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
import CallFab from '../components/CallFab.astro';
import { FAQS_HOME, faqPageSchema } from '../consts';
---

<Layout schema={[faqPageSchema(FAQS_HOME)]}>
  <Header />
  <main id="contenido">
    <Hero />
    <Experiencia />
    <Servicios />
    <Portafolio />
    <Proceso />
    <Testimonios />
    <Giros />
    <QuoteCTA />
    <Location />
  </main>
  <Footer />
  <CallFab />
</Layout>
