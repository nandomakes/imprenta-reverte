---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CONTACT, PHONE_DISPLAY, PHONE_TEL, SITE, WHATSAPP_URL } from '../consts';
---

<Layout
  title={`Gracias por tu solicitud | ${SITE.brand}`}
  description="Recibimos tu solicitud de cotización. Te contestamos en horario de tienda."
  noindex
>
  <Header />
  <main id="contenido" class="bg-mist">
    <div class="mx-auto max-w-2xl px-6 py-20 text-center md:py-28">
      <span
        class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-brand text-white"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-8 w-8"
        >
          <path d="M4 12.5l5.5 5.5L20 7"></path>
        </svg>
      </span>

      <h1 class="headline mt-7 text-3xl text-ink sm:text-4xl">Recibimos tu solicitud</h1>
      <p class="mt-5 text-lg leading-relaxed text-char">
        Gracias. Ya tenemos los datos de tu trabajo y te contestamos con precio y fecha de entrega
        dentro del horario de tienda: {CONTACT.hoursText.toLowerCase()}.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a
          href={`tel:${PHONE_TEL}`}
          class="pressable inline-flex items-center justify-center rounded-lg bg-accent px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-accentDk"
        >
          Llamar al {PHONE_DISPLAY}
        </a>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener"
          class="pressable inline-flex items-center justify-center rounded-lg border-2 border-brand px-7 py-3.5 text-base font-semibold text-brand transition-colors hover:bg-brand hover:text-white"
        >
          Escribir por WhatsApp
        </a>
      </div>

      <p class="mt-10 text-char">
        Mientras tanto, puedes{' '}
        <a href="/catalogo/" class="font-semibold text-brand underline underline-offset-4">
          seguir viendo el catálogo
        </a>{' '}
        o pasar al local en {CONTACT.addressLine}, {CONTACT.locality}.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
