---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CallFab from '../../components/CallFab.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';
import Carrusel from '../../components/Carrusel.astro';
import PageHead from '../../components/PageHead.astro';
import Foto from '../../components/Foto.astro';
import Cta from '../../components/Cta.astro';
import { CATEGORIAS, CONTACT, SITE, TRES_MANERAS, type Categoria } from '../../consts';

export function getStaticPaths() {
  return CATEGORIAS.map((categoria) => ({
    params: { slug: categoria.slug },
    props: { categoria },
  }));
}

interface Props {
  categoria: Categoria;
}

const { categoria: c } = Astro.props;

const title = `${c.etiqueta} en Ciudad Valles | ${SITE.brand}`;
const description = `${c.resumen} ${c.ejemplos.slice(0, 5).join(', ')} y más en Imprenta Reverte, ${CONTACT.locality}, ${CONTACT.regionCode}. Cotiza ahora.`;

const tonos: Record<string, string> = {
  card1: 'bg-card1',
  card2: 'bg-card2',
  card3: 'bg-card3',
  card4: 'bg-card4',
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Catálogo', item: `${SITE.url}/catalogo/` },
    { '@type': 'ListItem', position: 3, name: c.etiqueta, item: `${SITE.url}/catalogo/${c.slug}/` },
  ],
};

const servicio = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: c.etiqueta,
  description: c.descripcion,
  serviceType: c.etiqueta,
  provider: { '@id': `${SITE.url}/#negocio` },
  areaServed: {
    '@type': 'City',
    name: CONTACT.locality,
    address: {
      '@type': 'PostalAddress',
      addressRegion: CONTACT.regionCode,
      addressCountry: CONTACT.country,
    },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: c.etiqueta,
    itemListElement: c.ejemplos.map((e) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Product', name: e },
    })),
  },
};
---

<Layout title={title} description={description} schema={[breadcrumb, servicio]}>
  <Header />
  <main id="contenido">
    <PageHead
      titulo={c.etiqueta}
      migas={[
        { label: 'Inicio', href: '/' },
        { label: 'Catálogo', href: '/catalogo/' },
        { label: c.etiqueta },
      ]}
    />

    <section class="shell grid items-center gap-8 py-10 md:py-14 lg:grid-cols-2 lg:gap-12">
      <div class={`order-1 overflow-hidden lg:order-2 ${tonos[c.tono] ?? 'bg-paper'}`}>
        <Foto
          id={c.imagen}
          alt={c.imagenAlt}
          prioridad
          ratio="4/3"
          sizes="(min-width:1024px) 620px, 100vw"
        />
      </div>
      <div class="order-2 lg:order-1">
        <p class="text-[17px] leading-relaxed text-ink">{c.descripcion}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Cta href="#cotizar" />
          <a href="/catalogo/" class="btn-brand">Ver todo el catálogo</a>
        </div>
      </div>
    </section>

    <section class="bg-paper py-12 md:py-16">
      <div class="shell grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-14">
        <div>
          <h2 class="h-sec reveal">Todo lo que hacemos en esta categoría</h2>
          {/* Estilo carta: nombre del producto + su técnica de impresión, tal
              como las rotula el catálogo. Si una categoría no trae el detalle
              por producto (hoy solo "Otros servicios"), cae a la lista plana
              de ejemplos. */}
          {c.productos ? (
            <ul class="reveal mt-7 divide-y divide-line">
              {c.productos.map((p) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3.5">
                  <span class="text-[15px] text-ink">{p.nombre}</span>
                  <span class="eyebrow text-[11px] text-ash">{p.tecnica}</span>
                </li>
              ))}
            </ul>
          ) : (
            <ul class="reveal mt-7 grid gap-x-8 gap-y-0 sm:grid-cols-2">
              {c.ejemplos.map((e) => (
                <li class="flex items-start gap-3 border-b border-line py-3 text-[15px] text-ink">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-1 h-3.5 w-3.5 shrink-0 text-brand"
                  >
                    <path d="M3 8.5l3.5 3.5L13 5" />
                  </svg>
                  <span class="capitalize-first">{e}</span>
                </li>
              ))}
            </ul>
          )}

          {
            /* El contraste del catálogo, tal cual está en la fuente: es lo que
               evita que alguien pida una taza creyendo que entra en textil. */
            c.noIncluye && (
              <div class="reveal mt-8 border-l-4 border-accent bg-white px-5 py-4">
                <p class="eyebrow text-[13px] text-ink">
                  Esto va en otra categoría
                </p>
                <p class="mt-2 text-[15px] leading-relaxed">
                  En <strong class="text-ink">{c.etiqueta}</strong> no entran {c.noIncluye}.{' '}
                  <a href="/catalogo/" class="font-semibold text-brand underline underline-offset-4">
                    Revisa el catálogo completo
                  </a>{' '}
                  para encontrar dónde va.
                </p>
              </div>
            )
          }
        </div>

        <aside class="reveal lg:sticky lg:top-32 lg:self-start">
          {
            c.aSaber && (
              <div class="bg-white p-6">
                <h2 class="text-[19px] font-semibold text-ink">Antes de cotizar</h2>
                <ul class="mt-4 space-y-3.5">
                  {c.aSaber.map((a) => (
                    <li class="flex gap-3 text-[15px] leading-relaxed">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                      <span>{a}</span>
                    </li>
                  ))}
                </ul>
                <Cta href="#cotizar" class="mt-6 w-full" />
              </div>
            )
          }

          <div class="mt-6 bg-white p-6">
            <h2 class="text-[19px] font-semibold text-ink">Cómo trabajamos</h2>
            <ol class="mt-4 space-y-4">
              {
                TRES_MANERAS.map((m, i) => (
                  <li class="flex gap-3">
                    <span class="text-[14px] font-bold text-brand" aria-hidden="true">
                      0{i + 1}
                    </span>
                    <span class="text-[14px] leading-relaxed">
                      <strong class="block font-semibold text-ink">{m.titulo}</strong>
                      {m.texto}
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
        </aside>
      </div>
    </section>

    <QuoteCTA categoria={c.slug} titulo={`Cotiza tu trabajo de ${c.etiqueta.toLowerCase()}`} />

    <Carrusel
      titulo="Otras categorías del catálogo"
      slugs={CATEGORIAS.filter((x) => x.slug !== c.slug).map((x) => x.slug)}
    />
  </main>
  <Footer />
  <CallFab />
</Layout>

<style>
  /* Los ejemplos vienen en minúscula desde el catálogo (así se leen bien
     dentro de una frase); en la lista se muestran capitalizados. */
  .capitalize-first::first-letter {
    text-transform: uppercase;
  }
</style>
