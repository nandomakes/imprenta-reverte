---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CallFab from '../../components/CallFab.astro';
import CtaDuo from '../../components/CtaDuo.astro';
import PageHead from '../../components/PageHead.astro';
import Foto from '../../components/Foto.astro';
import { CATEGORIAS, SITE } from '../../consts';

const title = `Catálogo de imprenta | ${SITE.brand} — Ciudad Valles, SLP`;
const description =
  'Catálogo completo de Imprenta Reverte: papelería, sellos, impresión comercial, gran formato, DTF, serigrafía, sublimación, bordado, grabado láser y eventos en Ciudad Valles, SLP.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Catálogo', item: `${SITE.url}/catalogo/` },
  ],
};

const tonos: Record<string, string> = {
  card1: 'bg-card1',
  card2: 'bg-card2',
  card3: 'bg-card3',
  card4: 'bg-card4',
};
---

<Layout title={title} description={description} schema={[breadcrumb]}>
  <Header />
  <main id="contenido">
    <PageHead
      titulo="Todo el catálogo"
      intro="Diecisiete categorías con todo lo que imprimimos. Es una guía para consultar, no una tienda: cuando encuentres lo tuyo, pídenos precio."
      migas={[{ label: 'Inicio', href: '/' }, { label: 'Catálogo' }]}
    />

    {/* El buscador de la cabecera manda aquí con ?q=. Se resuelve en el
        cliente sobre el HTML ya renderizado: son 9 categorías, no hace falta
        un índice ni un servidor para filtrarlas. */}
    <div class="shell pt-8">
      <p id="aviso-busqueda" hidden class="mb-6 border-l-4 border-brand bg-paper px-5 py-3 text-[15px]"></p>
    </div>

    <section class="shell pb-12 pt-4 md:pb-16">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-lista>
        {
          CATEGORIAS.map((c) => (
            <li
              class="reveal"
              data-cat
              data-busca={`${c.etiqueta} ${c.ejemplos.join(' ')}`.toLowerCase()}
            >
              <a
                href={`/catalogo/${c.slug}/`}
                class="zoom-parent lift group flex h-full flex-col border border-line bg-white"
              >
                <div class={`overflow-hidden ${tonos[c.tono] ?? 'bg-paper'}`}>
                  <Foto
                    id={c.imagen}
                    alt={c.imagenAlt}
                    ratio="16/10"
                    sizes="(min-width:1024px) 420px, (min-width:640px) 50vw, 100vw"
                    class="zoom-img"
                  />
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <h2 class="text-[18px] font-semibold leading-snug text-ink group-hover:text-brand">
                    {c.etiqueta}
                  </h2>
                  <p class="mt-2 text-[15px] leading-relaxed">{c.resumen}</p>
                  <p class="mt-3 text-[13px] leading-relaxed text-ash">
                    {c.ejemplos.slice(0, 4).join(' · ')}
                    {c.ejemplos.length > 4 && ` · +${c.ejemplos.length - 4} más`}
                  </p>
                  <span class="mt-4 inline-flex items-center gap-1.5 text-[15px] font-semibold text-brand">
                    Ver categoría
                    <svg
                      viewBox="0 0 16 16"
                      class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <p id="sin-resultados" hidden class="py-10 text-center text-[16px]">
        No encontramos esa palabra en el catálogo.{' '}
        <a href="/cotizar/" class="font-semibold text-brand underline underline-offset-4">
          Pregúntanos directamente
        </a>{' '}
        — muchas veces sí lo hacemos.
      </p>
    </section>

    <CtaDuo />
  </main>
  <Footer />
  <CallFab />
</Layout>

<script>
  const q = new URLSearchParams(location.search).get('q')?.trim().toLowerCase();
  if (q) {
    const fichas = [...document.querySelectorAll<HTMLElement>('[data-cat]')];
    let visibles = 0;
    fichas.forEach((f) => {
      const coincide = (f.dataset.busca ?? '').includes(q);
      f.hidden = !coincide;
      if (coincide) visibles++;
    });
    const aviso = document.getElementById('aviso-busqueda');
    if (aviso) {
      aviso.textContent = visibles
        ? `${visibles} categoría${visibles === 1 ? '' : 's'} para "${q}".`
        : `Sin coincidencias para "${q}".`;
      aviso.hidden = false;
    }
    // Sin resultados: en vez de una lista vacía, un camino a la cotización.
    if (!visibles) {
      const vacio = document.getElementById('sin-resultados');
      if (vacio) vacio.hidden = false;
    }
  }
</script>
