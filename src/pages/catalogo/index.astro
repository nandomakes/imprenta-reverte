---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CallFab from '../../components/CallFab.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';
import Foto from '../../components/Foto.astro';
import Cta from '../../components/Cta.astro';
import { CATEGORIAS, SITE } from '../../consts';

const title = `Catálogo de imprenta | ${SITE.brand} — Ciudad Valles, SLP`;
const description =
  'Catálogo completo de Imprenta Reverte: papelería comercial y médica, publicidad, gran formato, textil, grabado láser, sellos e impresión para eventos en Ciudad Valles, SLP.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Catálogo', item: `${SITE.url}/catalogo/` },
  ],
};
---

<Layout title={title} description={description} schema={[breadcrumb]}>
  <Header />
  <main id="contenido">
    <section class="border-b border-line bg-mist">
      <div class="mx-auto max-w-7xl px-6 py-14 md:py-16">
        <nav aria-label="Ruta" class="text-sm text-ash">
          <a href="/" class="hover:text-brand">Inicio</a>
          <span class="mx-2" aria-hidden="true">/</span>
          <span class="text-char">Catálogo</span>
        </nav>
        <h1 class="headline mt-4 max-w-3xl text-4xl text-ink sm:text-5xl">
          Catálogo completo
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-char">
          Esto es todo lo que imprimimos, agrupado en nueve categorías. Es una guía para consultar,
          no una tienda: cuando encuentres lo tuyo, pídenos precio y te cotizamos.
        </p>
        <div class="mt-7">
          <Cta href="/contacto/#cotizar" tamano="lg" />
        </div>
      </div>
    </section>

    {/* Índice rápido: nueve categorías es demasiado para hacer scroll a ciegas
        desde el móvil. */}
    <nav aria-label="Índice del catálogo" class="border-b border-line bg-white">
      <div class="mx-auto max-w-7xl px-6 py-5">
        <ul class="flex flex-wrap gap-2">
          {
            CATEGORIAS.map((c) => (
              <li>
                <a
                  href={`#${c.slug}`}
                  class="inline-block rounded-full border border-line px-3.5 py-1.5 text-sm text-char transition-colors hover:border-brand hover:bg-brandLt hover:text-brand"
                >
                  {c.etiqueta}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="mx-auto max-w-7xl px-6 py-14 md:py-16">
      <div class="space-y-16">
        {
          CATEGORIAS.map((c) => (
            <section id={c.slug} class="reveal scroll-mt-28">
              <div class="grid gap-8 lg:grid-cols-[340px_1fr]">
                <div>
                  <div class="overflow-hidden rounded-xl border border-line">
                    <Foto
                      id={c.imagen}
                      alt={c.imagenAlt}
                      ratio="4/3"
                      sizes="(min-width:1024px) 340px, 100vw"
                    />
                  </div>
                  <a
                    href={`/catalogo/${c.slug}/`}
                    class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brandDk"
                  >
                    Ver la categoría a detalle
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-3.5 w-3.5"
                    >
                      <path d="M3 8h10M9 4l4 4-4 4" />
                    </svg>
                  </a>
                </div>

                <div>
                  <h2 class="headline text-2xl text-ink sm:text-3xl">
                    <a href={`/catalogo/${c.slug}/`} class="hover:text-brand">
                      {c.etiqueta}
                    </a>
                  </h2>
                  <p class="mt-3 leading-relaxed text-char">{c.descripcion}</p>

                  <ul class="mt-6 grid gap-x-6 gap-y-2.5 sm:grid-cols-2">
                    {c.ejemplos.map((e) => (
                      <li class="flex items-start gap-2.5 text-[0.9375rem] text-ink">
                        <svg
                          aria-hidden="true"
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="mt-1 h-3.5 w-3.5 shrink-0 text-brand"
                        >
                          <path d="M3 8.5l3.5 3.5L13 5" />
                        </svg>
                        <span class="capitalize-first">{e}</span>
                      </li>
                    ))}
                  </ul>

                  {c.noIncluye && (
                    <p class="mt-5 rounded-lg border border-line bg-mist px-4 py-3 text-sm leading-relaxed text-char">
                      <strong class="font-semibold text-ink">Ojo:</strong> aquí no entran {c.noIncluye}.
                    </p>
                  )}
                </div>
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <QuoteCTA titulo="¿Ya sabes qué necesitas? Pide tu precio" />
  </main>
  <Footer />
  <CallFab />
</Layout>

<style>
  /* Los ejemplos vienen en minúscula desde el catálogo (así se leen bien
     dentro de una frase); en la lista se muestran capitalizados. */
  .capitalize-first::first-letter {
    text-transform: uppercase;
  }
</style>
