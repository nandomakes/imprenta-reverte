---
// Quicksand es la tipografía de printshopsolution.com (comprobado con
// getComputedStyle sobre el sitio en vivo). Autoalojada: sin petición
// bloqueante a fonts.googleapis.com y sin mandar la IP de cada visitante a
// Google. Solo subconjunto latino.
import '@fontsource/quicksand/latin-400.css';
import '@fontsource/quicksand/latin-500.css';
import '@fontsource/quicksand/latin-600.css';
import '@fontsource/quicksand/latin-700.css';
// Manuscrita solo para el titular del hero, igual que la referencia.
import '@fontsource/dancing-script/latin-600.css';
import '../styles/global.css';
import {
  SITE,
  CONTACT,
  PHONE_TEL,
  SOCIALS,
  CATEGORIAS,
  TESTIMONIOS,
} from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Fuera del índice (lo usan /gracias y /404). */
  noindex?: boolean;
  /** Nodos JSON-LD propios de la página (BreadcrumbList, FAQPage, Service…). */
  schema?: unknown[];
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  schema = [],
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-image.png', site).href;

const negocio = {
  '@context': 'https://schema.org',
  '@type': 'PrintShop',
  '@id': `${SITE.url}/#negocio`,
  name: SITE.brand,
  description: SITE.description,
  url: SITE.url,
  image: ogImage,
  telephone: PHONE_TEL,
  priceRange: '$$',
  currenciesAccepted: 'MXN',
  paymentAccepted: 'Efectivo, Transferencia, Tarjeta',
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.addressLine,
    addressLocality: CONTACT.locality,
    addressRegion: CONTACT.regionCode,
    postalCode: CONTACT.postalCode,
    addressCountry: CONTACT.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: CONTACT.geo.lat,
    longitude: CONTACT.geo.lng,
  },
  openingHoursSpecification: CONTACT.hoursSpec.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  areaServed: [
    'Ciudad Valles',
    'Tamuín',
    'El Naranjo',
    'Tamazunchale',
    'Xilitla',
    'Huasteca Potosina',
    'San Luis Potosí',
  ],
  // Reseñas reales detrás de cualquier valoración: Google descuenta (y puede
  // penalizar) una calificación agregada sin reseñas que la respalden.
  review: TESTIMONIOS.map((t) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: t.autor },
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    reviewBody: t.texto,
  })),
  sameAs: SOCIALS.map((s) => s.href),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Catálogo de servicios de imprenta',
    itemListElement: CATEGORIAS.map((c) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: c.etiqueta,
        description: c.ejemplos.join(', '),
        url: `${SITE.url}/catalogo/${c.slug}/`,
      },
    })),
  },
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.brand,
  publisher: { '@id': `${SITE.url}/#negocio` },
  inLanguage: 'es-MX',
};

const jsonLdNodes = [negocio, website, ...schema];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Todas las fotos vienen del CDN de Unsplash; abrir la conexión temprano
         le quita el DNS+TLS al camino crítico de la imagen del hero. -->
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Una página noindex no debe declararse canónica de nada. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.brand} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="geo.region" content="MX-SLP" />
    <meta name="geo.placename" content={CONTACT.locality} />
    <meta name="geo.position" content={`${CONTACT.geo.lat};${CONTACT.geo.lng}`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${SITE.brand} — imprenta en ${CONTACT.locality}, ${CONTACT.regionCode}`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      jsonLdNodes.map((node) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }

    <!-- El modo "reveal" solo se activa si hay JS; sin JS todo queda visible. -->
    <script is:inline>
      document.documentElement.setAttribute('data-reveal', '');
    </script>
  </head>
  <body class="bg-white font-sans text-ink antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-brand focus:px-4 focus:py-2 focus:font-bold focus:text-white"
    >
      Saltar al contenido
    </a>
    <slot />

    <script>
      // Reveal escalonado por hermanos, para que rejillas y filas entren en
      // cascada en vez de todas a la vez.
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      reveals.forEach((el) => {
        const hermanos = el.parentElement
          ? Array.from(el.parentElement.children).filter((c) => c.classList.contains('reveal'))
          : [el];
        el.style.setProperty('--reveal-i', String(Math.min(hermanos.indexOf(el), 6)));
      });

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
      );
      reveals.forEach((el) => io.observe(el));

      // Sombra del header al hacer scroll.
      const header = document.querySelector('header');
      if (header) {
        const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 16);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // Menú móvil (panel deslizante, como el hamburguesa de la referencia).
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      if (toggle && menu) {
        const cerrar = () => {
          toggle.setAttribute('aria-expanded', 'false');
          menu.hidden = true;
          document.body.style.overflow = '';
        };
        toggle.addEventListener('click', () => {
          const abierto = toggle.getAttribute('aria-expanded') === 'true';
          if (abierto) return cerrar();
          toggle.setAttribute('aria-expanded', 'true');
          menu.hidden = false;
          // Con el panel abierto la página de atrás no debe desplazarse.
          document.body.style.overflow = 'hidden';
        });
        menu.addEventListener('click', (e) => {
          const t = e.target as HTMLElement;
          if (t.closest('a') || t.hasAttribute('data-menu-cerrar')) cerrar();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.hidden) cerrar();
        });
      }

      // Carruseles horizontales. En móvil se arrastran con el dedo; las
      // flechas avanzan SIEMPRE una tarjeta exacta.
      //
      // La posición de destino se calcula desde la geometría real de cada
      // tarjeta, no sumando "ancho + hueco": el hueco cambia con el breakpoint
      // (16px en móvil, 24px desde `sm`) y esa diferencia se iba acumulando
      // hasta dejar la cuarta tarjeta cortada a media altura.
      document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((raiz) => {
        const rail = raiz.querySelector<HTMLElement>('.rail');
        const prev = raiz.querySelector<HTMLButtonElement>('[data-prev]');
        const next = raiz.querySelector<HTMLButtonElement>('[data-next]');
        if (!rail) return;

        const maxScroll = () => Math.max(0, rail.scrollWidth - rail.clientWidth);

        /** scrollLeft con el que el borde izquierdo de `el` queda al ras. */
        const posDe = (el: Element) => {
          const relleno = parseFloat(getComputedStyle(rail).paddingLeft) || 0;
          return Math.round(
            rail.scrollLeft + el.getBoundingClientRect().left - rail.getBoundingClientRect().left - relleno
          );
        };

        const mover = (dir: 1 | -1) => {
          const paradas = [...rail.children].map(posDe);
          const max = maxScroll();
          const actual = rail.scrollLeft;
          let destino: number | undefined;

          if (dir === 1) {
            destino = paradas.find((p) => p > actual + 2);
          } else {
            const previas = paradas.filter((p) => p < actual - 2);
            destino = previas.length ? previas[previas.length - 1] : 0;
          }
          if (destino === undefined) destino = dir === 1 ? max : 0;

          // Si el siguiente salto dejaría al final un trozo de tarjeta sin
          // mostrar, se va hasta el tope de una vez: así la última tarjeta
          // siempre aparece entera y nunca queda "un cachito" pendiente.
          if (destino > max - 2) destino = max;

          rail.scrollTo({ left: Math.max(0, Math.min(destino, max)), behavior: 'smooth' });
        };

        prev?.addEventListener('click', () => mover(-1));
        next?.addEventListener('click', () => mover(1));

        // Las dos flechas están siempre presentes; la que no lleva a ningún
        // lado se atenúa (ver `.arrow:disabled` en global.css). Ocultarlas
        // movía el resto de la fila al llegar a los extremos.
        const sync = () => {
          const max = maxScroll();
          if (prev) prev.disabled = rail.scrollLeft <= 2;
          if (next) next.disabled = rail.scrollLeft >= max - 2;
        };
        rail.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync);
        // Las fotos llegan del CDN y cambian el ancho del carril al cargar.
        rail.querySelectorAll('img').forEach((img) => {
          if (!img.complete) img.addEventListener('load', sync, { once: true });
        });
        sync();
      });

      // Slider del hero: autoavance con pausa al pasar el cursor.
      const slider = document.querySelector<HTMLElement>('[data-slider]');
      if (slider) {
        const slides = [...slider.querySelectorAll<HTMLElement>('[data-slide]')];
        const puntos = [...slider.querySelectorAll<HTMLButtonElement>('[data-punto]')];
        let i = 0;
        let timer = 0;
        const ir = (n: number) => {
          i = (n + slides.length) % slides.length;
          slides.forEach((s, k) => {
            s.classList.toggle('opacity-0', k !== i);
            s.classList.toggle('pointer-events-none', k !== i);
            s.setAttribute('aria-hidden', String(k !== i));
          });
          puntos.forEach((p, k) => p.setAttribute('aria-current', String(k === i)));
        };
        const arrancar = () => {
          if (slides.length < 2) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          timer = window.setInterval(() => ir(i + 1), 6500);
        };
        const parar = () => window.clearInterval(timer);
        slider.querySelector('[data-slider-prev]')?.addEventListener('click', () => { parar(); ir(i - 1); arrancar(); });
        slider.querySelector('[data-slider-next]')?.addEventListener('click', () => { parar(); ir(i + 1); arrancar(); });
        puntos.forEach((p, k) => p.addEventListener('click', () => { parar(); ir(k); arrancar(); }));
        slider.addEventListener('mouseenter', parar);
        slider.addEventListener('mouseleave', arrancar);
        ir(0);
        arrancar();
      }

      // Barra promocional: se cierra y no vuelve en la sesión.
      const promo = document.querySelector<HTMLElement>('[data-promo]');
      if (promo) {
        try {
          if (sessionStorage.getItem('promo-cerrada') === '1') promo.hidden = true;
        } catch {
          /* modo privado: da igual, se muestra */
        }
        promo.querySelector('[data-promo-cerrar]')?.addEventListener('click', () => {
          promo.hidden = true;
          try {
            sessionStorage.setItem('promo-cerrada', '1');
          } catch {
            /* sin persistencia, pero cerrada en esta vista */
          }
        });
      }
    </script>
  </body>
</html>
