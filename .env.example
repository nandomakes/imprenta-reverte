# PLANTILLA PÚBLICA — este archivo SÍ se sube a git.
# Nunca pongas valores reales aquí: cópialo a `.env` (que está en .gitignore)
# y rellena allí. Si alguna vez pegas una credencial real en este archivo y la
# subes, hay que rotarla, no solo borrarla: ya quedó en el historial.
#
# El sitio FUNCIONA sin estas variables: el formulario acepta el lead y lo
# escribe en el log del servidor. En cuanto pongas la API key, además llega
# por correo. Ver README.md.

# API key de Resend — https://resend.com/api-keys
RESEND_API_KEY=

# A dónde llegan las cotizaciones.
QUOTE_TO_EMAIL=contacto@imprentareverte.com

# Remitente. El dominio debe estar verificado en Resend.
# Para probar sin dominio propio, Resend permite: onboarding@resend.dev
QUOTE_FROM_EMAIL=cotizaciones@imprentareverte.com

# Aviso instantáneo por Telegram de cada cotización (opcional, además del correo).
# Token del bot creado con @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat al que llega el aviso. En un grupo es negativo (ej. -1002345678901),
# visto en https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=
