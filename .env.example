# Copia este archivo a `.env` y rellena los valores.
# El sitio FUNCIONA sin estas variables: el formulario acepta el lead y lo
# escribe en el log del servidor. En cuanto pongas la API key, además llega
# por correo. Ver README.md.

# API key de Resend — https://resend.com/api-keys
RESEND_API_KEY=

# A dónde llegan las cotizaciones.
QUOTE_TO_EMAIL=contacto@imprentareverte.com

# Remitente. El dominio debe estar verificado en Resend.
# Para probar sin dominio propio, Resend permite: onboarding@resend.dev
QUOTE_FROM_EMAIL=cotizaciones@imprentareverte.com
